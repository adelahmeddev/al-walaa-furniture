---
import { useTranslations } from '../i18n/ui';
import settings from '../data/settings.json';
import { MessageCircle, Phone, ShieldCheck, Clock, Check } from '@lucide/astro';

interface Props {
  lang: 'ar' | 'en';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const isAr = lang === 'ar';

const phone = settings.phone;
const displayPhone = settings.displayPhone;
const message = isAr
  ? encodeURIComponent('مرحباً، أريد الاستفادة من خصم الـ 20% وحجز موعد لنقل العفش')
  : encodeURIComponent('Hello, I would like to claim the 20% discount and book a move');

const whatsappLink = `https://wa.me/${settings.whatsappNumber}?text=${message}`;
---

<section class="dark-surface py-12 md:py-24 bg-primary-900 text-white text-center border-t-4 border-accent-400">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <p class="text-xs sm:text-sm font-semibold text-accent-300 mb-2.5 sm:mb-3">
      {t('cta.eyebrow')}
    </p>

    <h2 class="heading-section font-extrabold text-white tracking-tight mb-3 sm:mb-4">
      {t('cta.title')}
    </h2>

    <p class="prose-pretty text-sm sm:text-lg text-slate-200 mb-7 sm:mb-9 max-w-[54ch] mx-auto leading-relaxed">
      {t('cta.subtitle')}
    </p>

    <div class="flex flex-col sm:flex-row gap-3.5 justify-center items-stretch sm:items-center">
      <a
        href={whatsappLink}
        data-contact-whatsapp
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-2.5 bg-whatsapp hover:bg-whatsapp-hover active:scale-[0.99] text-white px-7 py-4 rounded-xl font-bold text-base shadow-md transition-all min-h-[52px]"
      >
        <MessageCircle class="w-5 h-5" aria-hidden="true" />
        <span>{t('whatsapp.btn')}</span>
      </a>

      <a
        href={`tel:${phone}`}
        data-contact-tel
        class="inline-flex items-center justify-center gap-2.5 bg-white text-primary-900 hover:bg-stone-100 active:scale-[0.99] px-7 py-4 rounded-xl font-bold text-base shadow-md transition-all min-h-[52px]"
      >
        <Phone class="w-5 h-5 text-accent" aria-hidden="true" />
        <span dir="ltr" data-contact-phone-display>{displayPhone}</span>
      </a>
    </div>

    <div class="mt-9 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-xs sm:text-sm text-slate-200">
      <span class="inline-flex items-center gap-1.5">
        <ShieldCheck class="w-4 h-4 text-emerald-300" aria-hidden="true" />
        <span>{t('cta.point1')}</span>
      </span>
      <span class="inline-flex items-center gap-1.5">
        <Clock class="w-4 h-4 text-accent-300" aria-hidden="true" />
        <span>{t('cta.point2')}</span>
      </span>
      <span class="inline-flex items-center gap-1.5">
        <Check class="w-4 h-4 text-emerald-300" aria-hidden="true" />
        <span>{t('cta.point3')}</span>
      </span>
    </div>
  </div>
</section>
