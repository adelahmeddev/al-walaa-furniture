---
import { useTranslations } from '../i18n/ui';
import defaultSettings from '../data/settings.json';
import { getSocialLinks, buildWhatsAppLink } from '../utils/settings';
import SocialIcon from './SocialIcon.astro';
import { Phone, MapPin, Clock, MessageCircle, Lock } from '@lucide/astro';

interface Props {
  lang: 'ar' | 'en';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
const isAr = lang === 'ar';

const settings = defaultSettings;
const phone = settings.phone;
const displayPhone = settings.displayPhone;
const message = isAr
  ? 'مرحباً، أود التواصل وحجز موعد لنقل العفش'
  : 'Hello, I would like to get in touch and schedule a furniture move';
const whatsappLink = buildWhatsAppLink(settings.whatsappNumber, message);
const socialLinks = getSocialLinks(settings);
---

<footer class="dark-surface bg-primary-dark text-slate-200 pt-14 pb-24 sm:pb-10 border-t border-white/10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 text-start">
      <!-- Brand & Summary -->
      <div class="space-y-4">
        <a href={isAr ? '/' : '/en/'} class="inline-flex items-center gap-3">
          <span class="bg-white rounded-xl p-1 shadow-sm inline-flex items-center justify-center shrink-0">
            <img
              src="/logo.jpg"
              alt={isAr ? 'شعار شركة الولاء لنقل الأثاث' : 'Al Walaa Furniture Moving Logo'}
              width="52"
              height="52"
              class="w-12 h-12 object-contain"
            />
          </span>
          <div>
            <div class="text-xl sm:text-2xl font-extrabold text-white tracking-tight leading-none">
              {t('brand.name')}
            </div>
            <div class="text-xs font-semibold text-accent-300 mt-1">
              {t('brand.subtitle')}
            </div>
          </div>
        </a>

        <p class="text-slate-300 text-sm leading-relaxed max-w-sm">
          {t('footer.about')}
        </p>

        <div class="flex flex-wrap items-center gap-2.5 pt-1">
          <a
            href={whatsappLink}
            data-contact-whatsapp
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-4 py-2.5 bg-whatsapp hover:bg-whatsapp-hover text-white rounded-xl text-xs font-bold transition-colors min-h-[40px]"
          >
            <MessageCircle class="w-4 h-4" aria-hidden="true" />
            <span>{t('whatsapp.btn')}</span>
          </a>

          <div data-social-list class="inline-flex items-center gap-1.5">
            {socialLinks.map((item) => (
              <a
                data-social-key={item.key}
                href={item.url || '#'}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={item.label}
                class={`inline-flex items-center justify-center w-10 h-10 rounded-xl bg-white/10 text-slate-200 hover:bg-accent-400 hover:text-primary-900 transition-colors ${item.url ? '' : 'hidden'}`}
              >
                <SocialIcon platform={item.key} class="w-4 h-4" />
              </a>
            ))}
          </div>
        </div>
      </div>

      <!-- Services -->
      <div>
        <h3 class="text-sm font-bold text-white uppercase tracking-wider mb-4">
          {t('nav.services')}
        </h3>
        <ul class="space-y-2.5 text-slate-300 text-sm">
          <li><a href="#services" class="hover:text-accent-300 transition-colors py-0.5 inline-block">{t('services.local')}</a></li>
          <li><a href="#services" class="hover:text-accent-300 transition-colors py-0.5 inline-block">{t('services.cities')}</a></li>
          <li><a href="#services" class="hover:text-accent-300 transition-colors py-0.5 inline-block">{t('services.heavy')}</a></li>
          <li><a href="#services" class="hover:text-accent-300 transition-colors py-0.5 inline-block">{t('services.install')}</a></li>
          <li><a href="#services" class="hover:text-accent-300 transition-colors py-0.5 inline-block">{t('services.pack')}</a></li>
          <li><a href="#services" class="hover:text-accent-300 transition-colors py-0.5 inline-block">{t('services.storage')}</a></li>
        </ul>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="text-sm font-bold text-white uppercase tracking-wider mb-4">
          {t('footer.quickLinks')}
        </h3>
        <ul class="space-y-2.5 text-slate-300 text-sm">
          <li><a href="#home" class="hover:text-accent-300 transition-colors py-0.5 inline-block">{t('nav.home')}</a></li>
          <li><a href="#gallery" class="hover:text-accent-300 transition-colors py-0.5 inline-block">{t('nav.gallery')}</a></li>
          <li><a href="#whyus" class="hover:text-accent-300 transition-colors py-0.5 inline-block">{t('nav.whyus')}</a></li>
          <li><a href="#howitworks" class="hover:text-accent-300 transition-colors py-0.5 inline-block">{t('nav.howitworks')}</a></li>
          <li><a href="#areas" class="hover:text-accent-300 transition-colors py-0.5 inline-block">{t('nav.areas')}</a></li>
          <li><a href="#faq" class="hover:text-accent-300 transition-colors py-0.5 inline-block">{t('nav.faq')}</a></li>
        </ul>
      </div>

      <!-- Contact Details -->
      <div>
        <h3 class="text-sm font-bold text-white uppercase tracking-wider mb-4">
          {t('nav.contact')}
        </h3>
        <ul class="space-y-3.5 text-slate-300 text-sm">
          <li class="flex items-center gap-3">
            <span class="w-9 h-9 rounded-lg bg-white/10 text-accent-300 flex items-center justify-center shrink-0">
              <Phone class="w-4 h-4" aria-hidden="true" />
            </span>
            <a href={`tel:${phone}`} data-contact-tel dir="ltr" class="text-base font-mono font-bold text-white hover:text-accent-300 transition-colors">
              <span data-contact-phone-display>{displayPhone}</span>
            </a>
          </li>
          <li class="flex items-center gap-3">
            <span class="w-9 h-9 rounded-lg bg-white/10 text-accent-300 flex items-center justify-center shrink-0">
              <MapPin class="w-4 h-4" aria-hidden="true" />
            </span>
            <span>{t('footer.location')}</span>
          </li>
          <li class="flex items-center gap-3">
            <span class="w-9 h-9 rounded-lg bg-white/10 text-accent-300 flex items-center justify-center shrink-0">
              <Clock class="w-4 h-4" aria-hidden="true" />
            </span>
            {isAr ? (
              <span data-contact-hours>{settings.workingHours || t('footer.hours')}</span>
            ) : (
              <span>{t('footer.hours')}</span>
            )}
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="border-t border-white/10 mt-12 pt-7 flex flex-col sm:flex-row items-center justify-between text-slate-400 text-xs gap-4">
      <p>&copy; {year} {t('brand.name')}. {t('footer.rights')}.</p>

      <div class="flex items-center gap-4">
        <span>{t('footer.tagline')}</span>
        <span aria-hidden="true">·</span>
        <a href="/admin" class="text-slate-300 hover:text-white transition-colors inline-flex items-center gap-1.5 py-1">
          <Lock class="w-3.5 h-3.5" aria-hidden="true" />
          <span>{t('footer.admin')}</span>
        </a>
      </div>
    </div>
  </div>
</footer>
