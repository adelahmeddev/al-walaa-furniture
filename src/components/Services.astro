---
import { useTranslations } from '../i18n/ui';
import settings from '../data/settings.json';
import { Truck, Map, Wrench, Package, ArrowUpFromLine, Warehouse, ArrowRight, ArrowLeft, Check } from '@lucide/astro';

interface Props {
  lang: 'ar' | 'en';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const isAr = lang === 'ar';
const phone = settings.whatsappNumber;

const featuredServices = [
  {
    id: 'local',
    icon: Truck,
    title: t('services.local'),
    desc: t('services.local.desc'),
    tag: t('services.local.tag'),
    features: isAr
      ? ['نقل خلال 3 إلى 6 ساعات', 'سيارات صندوقية مغلقة ومبطنة', 'رص وتثبيت يمنع الاحتكاك']
      : ['3 to 6-hour completion', 'Padded enclosed box trucks', 'Anchored cargo bracing'],
  },
  {
    id: 'heavy',
    icon: ArrowUpFromLine,
    title: t('services.heavy'),
    desc: t('services.heavy.desc'),
    tag: t('services.heavy.tag'),
    features: isAr
      ? ['وصول حتى الدور العشرين', 'تجاوز السلالم والمصاعد الضيقة', 'حماية الرخام والأجهزة الكبيرة']
      : ['Reaches up to 20th floor', 'Bypasses narrow staircases', 'Protects marble and appliances'],
  },
];

const specialtyServices = [
  {
    id: 'pack',
    icon: Package,
    title: t('services.pack'),
    desc: t('services.pack.desc'),
  },
  {
    id: 'install',
    icon: Wrench,
    title: t('services.install'),
    desc: t('services.install.desc'),
  },
  {
    id: 'cities',
    icon: Map,
    title: t('services.cities'),
    desc: t('services.cities.desc'),
  },
  {
    id: 'storage',
    icon: Warehouse,
    title: t('services.storage'),
    desc: t('services.storage.desc'),
  },
];

function getWhatsappLink(title: string): string {
  const msg = isAr
    ? `مرحباً، أريد الاستفسار وحجز خدمة: ${title}`
    : `Hello, I would like to inquire about: ${title}`;
  return `https://wa.me/${phone}?text=${encodeURIComponent(msg)}`;
}
---

<section id="services" class="scroll-mt-28 py-12 md:py-24 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Heading -->
    <div class="max-w-2xl mb-7 md:mb-12 text-start">
      <p class="text-xs sm:text-sm font-semibold text-accent mb-2">
        {t('services.eyebrow')}
      </p>
      <h2 class="heading-section font-extrabold text-primary-900 tracking-tight">
        {t('services.title')}
      </h2>
      <p class="prose-pretty mt-2.5 text-slate-600 text-sm sm:text-lg leading-relaxed">
        {t('services.subtitle')}
      </p>
    </div>

    <!-- Tier 1: Core Moving & Hydraulic Hoist Capabilities -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 sm:gap-6 mb-4 sm:mb-6">
      {featuredServices.map((service) => (
        <div class="bg-surface-warm rounded-2xl p-5 sm:p-8 border border-stone-200 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between gap-4 mb-4 sm:mb-5">
              <div class="w-11 h-11 sm:w-12 sm:h-12 rounded-xl bg-primary-900 text-accent-300 flex items-center justify-center shrink-0">
                <service.icon class="w-5 h-5 sm:w-6 sm:h-6" aria-hidden="true" />
              </div>
              <span class="text-xs font-semibold px-3 py-1 rounded-md bg-white text-primary-900 border border-stone-200">
                {service.tag}
              </span>
            </div>

            <h3 class="text-lg sm:text-2xl font-bold text-primary-900 mb-2">
              {service.title}
            </h3>
            <p class="text-slate-600 text-sm sm:text-base leading-relaxed mb-5 sm:mb-6">
              {service.desc}
            </p>

            <ul class="space-y-2 sm:space-y-2.5 mb-5 sm:mb-7 pt-3.5 sm:pt-4 border-t border-stone-200/80 text-xs sm:text-sm font-medium text-slate-700">
              {service.features.map((feat) => (
                <li class="flex items-center gap-2.5">
                  <span class="w-5 h-5 rounded-full bg-emerald-100 text-whatsapp flex items-center justify-center shrink-0">
                    <Check class="w-3.5 h-3.5 stroke-[2.5]" aria-hidden="true" />
                  </span>
                  <span>{feat}</span>
                </li>
              ))}
            </ul>
          </div>

          <a
            href={getWhatsappLink(service.title)}
            data-contact-whatsapp
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 py-3 px-5 rounded-xl bg-primary-900 hover:bg-primary text-white font-bold text-sm transition-colors w-full sm:w-auto sm:self-start min-h-[44px]"
          >
            <span>{t('services.book')}</span>
            {isAr ? <ArrowLeft class="w-4 h-4" aria-hidden="true" /> : <ArrowRight class="w-4 h-4" aria-hidden="true" />}
          </a>
        </div>
      ))}
    </div>

    <!-- Tier 2: Specialized Support Services (Compact horizontal rows on mobile -> 4-col grid on desktop) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3.5 sm:gap-5">
      {specialtyServices.map((service) => (
        <div class="bg-white rounded-2xl p-4 sm:p-6 border border-stone-200 flex sm:flex-col items-start sm:justify-between gap-3.5 sm:gap-0 hover:border-stone-300 hover:shadow-card-hover transition-all duration-200">
          <div class="w-10 h-10 sm:w-11 sm:h-11 rounded-xl bg-surface-warm border border-stone-200 text-primary-900 flex items-center justify-center shrink-0 sm:mb-4">
            <service.icon class="w-5 h-5 text-accent" aria-hidden="true" />
          </div>
          <div class="flex-1 min-w-0 sm:flex sm:flex-col sm:justify-between sm:w-full">
            <div>
              <h3 class="text-base sm:text-lg font-bold text-slate-900 mb-1.5 sm:mb-2 leading-snug">
                {service.title}
              </h3>
              <p class="text-slate-600 text-xs sm:text-sm leading-relaxed mb-3 sm:mb-5">
                {service.desc}
              </p>
            </div>

            <a
              href={getWhatsappLink(service.title)}
              data-contact-whatsapp
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-bold text-accent hover:text-accent-700 transition-colors self-start py-1"
            >
              <span>{t('services.book')}</span>
              {isAr ? <ArrowLeft class="w-4 h-4" aria-hidden="true" /> : <ArrowRight class="w-4 h-4" aria-hidden="true" />}
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
