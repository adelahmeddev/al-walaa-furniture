---
import '../styles/global.css';
import { useTranslations } from '../i18n/ui';
import { buildSeoSchemas } from '../utils/seo';
import { getInitialSettings, type SiteSettings } from '../utils/settings';

interface Props {
  title: string;
  lang: 'ar' | 'en';
  description?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  articleMeta?: {
    publishedTime?: string;
    modifiedTime?: string;
    section?: string;
    tags?: string[];
  };
  customSchemas?: Record<string, unknown>[];
  settings?: SiteSettings;
  alternateAr?: string;
  alternateEn?: string;
}

const {
  title,
  lang,
  description,
  ogImage = '/og-image.jpg',
  ogType = 'website',
  articleMeta,
  customSchemas,
  settings = getInitialSettings(),
  alternateAr,
  alternateEn,
} = Astro.props;

const t = useTranslations(lang);
const dir = lang === 'ar' ? 'rtl' : 'ltr';
const isAr = lang === 'ar';

const defaultDesc = isAr
  ? 'شركة نقل عفش في القاهرة والجيزة. فك وتركيب غرف ومطابخ، تغليف 5 طبقات، ونش رفع هيدروليكي حتى الدور 20، نقل بين المحافظات. ضمان مكتوب وسعر ثابت.'
  : 'Professional furniture moving company in Cairo & all Egypt. 5-layer packing, hydraulic hoists to floor 20, carpentry reassembly. Written damage guarantee & fixed pricing.';
const metaDesc = description || defaultDesc;

const keywords = isAr
  ? 'نقل عفش, شركة نقل عفش, نقل اثاث بالقاهرة, شركة نقل عفش بالجيزة, ونش رفع اثاث, تغليف عفش, فك وتركيب اثاث, شركة نقل موبيليا, نقل عفش التجمع الخامس, نقل عفش 6 اكتوبر, نقل عفش مدينة نصر, نقل عفش المعادي, نقل عفش بين المحافظات, ارخص شركة نقل عفش في مصر'
  : 'furniture moving egypt, moving company cairo, furniture packing cairo, hydraulic furniture hoist egypt, office relocation cairo, Al Walaa moving';

const siteOrigin = (Astro.site?.toString() || 'https://alwalaamoving.com').replace(/\/$/, '');
const canonicalUrl = new URL(Astro.url.pathname, siteOrigin).toString();

const pathname = Astro.url.pathname;
const cleanPath = pathname.replace(/\/$/, '') || '/';
const defaultArPath = isAr ? cleanPath : (cleanPath.replace(/^\/en/, '') || '/');
const defaultEnPath = isAr ? `/en${cleanPath === '/' ? '/' : cleanPath}` : cleanPath;

const arUrl = alternateAr
  ? (alternateAr.startsWith('http') ? alternateAr : `${siteOrigin}${alternateAr}`)
  : `${siteOrigin}${defaultArPath === '/' ? '/' : defaultArPath}`;
const enUrl = alternateEn
  ? (alternateEn.startsWith('http') ? alternateEn : `${siteOrigin}${alternateEn}`)
  : `${siteOrigin}${defaultEnPath === '/' ? '/' : defaultEnPath}`;

const ogImageUrl = ogImage.startsWith('http') ? ogImage : `${siteOrigin}${ogImage.startsWith('/') ? '' : '/'}${ogImage}`;
const schemas = customSchemas && customSchemas.length > 0
  ? customSchemas
  : buildSeoSchemas(lang, siteOrigin, canonicalUrl, settings);
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <!-- SEO & Local Geo Meta Tags -->
    <meta name="description" content={metaDesc} />
    <meta name="keywords" content={keywords} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <meta name="geo.region" content="EG-C" />
    <meta name="geo.placename" content="Cairo, Egypt" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Hreflang Language Alternates -->
    <link rel="alternate" hreflang="ar-EG" href={arUrl} />
    <link rel="alternate" hreflang="ar" href={arUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={arUrl} />

    <!-- Open Graph / Social Preview -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDesc} />
    <meta property="og:type" content={ogType} />
    {ogType === 'article' && articleMeta?.publishedTime && (
      <meta property="article:published_time" content={articleMeta.publishedTime} />
    )}
    {ogType === 'article' && articleMeta?.modifiedTime && (
      <meta property="article:modified_time" content={articleMeta.modifiedTime} />
    )}
    {ogType === 'article' && articleMeta?.section && (
      <meta property="article:section" content={articleMeta.section} />
    )}
    {ogType === 'article' && articleMeta?.tags && articleMeta.tags.map((tag) => (
      <meta property="article:tag" content={tag} />
    ))}
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={isAr ? 'شركة الولاء لنقل الأثاث' : 'Al Walaa Furniture Moving'} />
    <meta property="og:locale" content={isAr ? 'ar_EG' : 'en_US'} />
    <meta property="og:locale:alternate" content={isAr ? 'en_US' : 'ar_EG'} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={isAr ? 'شركة الولاء لنقل وتغليف الأثاث في القاهرة ومصر' : 'Al Walaa Furniture Moving in Cairo and Egypt'} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={metaDesc} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Preload Hero LCP Asset -->
    <link rel="preload" as="image" href="/media/hero-moving-egypt.webp" type="image/webp" />

    <!-- Google Fonts: Arabic (IBM Plex Sans Arabic + Cairo Display) & English (Plus Jakarta Sans + Inter) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cairo:wght@700;800&family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- JSON-LD Structured Data -->
    {schemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </head>
  <body class="overflow-x-hidden min-h-screen flex flex-col bg-surface-warm text-slate-800">
    <a href="#main-content" class="skip-link visually-hidden">
      {t('skip.content')}
    </a>

    <slot />

    <!-- Back to Top Button (State-driven visibility) -->
    <button
      type="button"
      id="back-to-top"
      class="fixed bottom-5 ltr:left-5 rtl:right-5 z-40 hidden sm:inline-flex items-center justify-center w-11 h-11 rounded-full bg-primary-900 hover:bg-primary text-white border border-white/20 shadow-lg transition-all duration-200 opacity-0 invisible translate-y-2"
      aria-label={t('backtop')}
    >
      <svg class="w-5 h-5" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.25" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7" />
      </svg>
    </button>

    <script>
      import Lenis from 'lenis';

      // Initialize Lenis smooth scroll
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let lenis: Lenis | null = null;

      if (!prefersReducedMotion) {
        lenis = new Lenis({
          duration: 1.15,
          easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
          orientation: 'vertical',
          gestureOrientation: 'vertical',
          smoothWheel: true,
          wheelMultiplier: 0.9,
          touchMultiplier: 1.5,
        });

        function raf(time: number) {
          lenis?.raf(time);
          requestAnimationFrame(raf);
        }

        requestAnimationFrame(raf);

        // Expose to window for components/modals if needed
        (window as any).lenis = lenis;
      }

      // Back to top button visibility on scroll
      const backToTopBtn = document.getElementById('back-to-top');
      if (backToTopBtn) {
        const updateBackTop = () => {
          const visible = window.scrollY > 450;
          backToTopBtn.classList.toggle('opacity-0', !visible);
          backToTopBtn.classList.toggle('invisible', !visible);
          backToTopBtn.classList.toggle('translate-y-2', !visible);
          backToTopBtn.classList.toggle('opacity-100', visible);
          backToTopBtn.classList.toggle('visible', visible);
          backToTopBtn.classList.toggle('translate-y-0', visible);
        };
        window.addEventListener('scroll', updateBackTop, { passive: true });
        updateBackTop();
        backToTopBtn.addEventListener('click', () => {
          if (lenis) {
            lenis.scrollTo(0, { duration: 1.2 });
          } else {
            const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            window.scrollTo({ top: 0, behavior: reduced ? 'auto' : 'smooth' });
          }
        });
      }
    </script>
  </body>
</html>
