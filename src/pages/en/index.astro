---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Hero from '../../components/Hero.astro';
import MediaGallery from '../../components/MediaGallery.astro';
import Stats from '../../components/Stats.astro';
import Services from '../../components/Services.astro';
import WhyUs from '../../components/WhyUs.astro';
import HowItWorks from '../../components/HowItWorks.astro';
import Areas from '../../components/Areas.astro';
import Testimonials from '../../components/Testimonials.astro';
import FAQ from '../../components/FAQ.astro';
import CTABanner from '../../components/CTABanner.astro';
import LatestPosts from '../../components/LatestPosts.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import Footer from '../../components/Footer.astro';
import { getBlogPosts, getMediaItems, getRuntimeEnv, getSiteSettings } from '../../utils/db';

export const prerender = false;

const lang = 'en';
const { db } = getRuntimeEnv(Astro.locals);
const [settings, mediaItems, recentPosts] = await Promise.all([
  getSiteSettings(db),
  getMediaItems(db),
  getBlogPosts(db, { lang, limit: 3, publishedOnly: true }),
]);

Astro.response.headers.set('Cache-Control', 'no-store');
---

<Layout
  title="Furniture Moving in Cairo & Egypt | Al Walaa — Packing, Hoisting & Reassembly"
  description="Professional furniture moving company in Cairo & all Egypt. 5-layer packing, hydraulic hoists to floor 20, carpentry reassembly. Written damage guarantee & fixed pricing."
  lang={lang}
  settings={settings}
>
  <Header lang={lang} settings={settings} />
  <main id="main-content" tabindex="-1">
    <Hero lang={lang} settings={settings} />
    <MediaGallery lang={lang} items={mediaItems} />
    <Stats lang={lang} />
    <Services lang={lang} settings={settings} />
    <WhyUs lang={lang} />
    <HowItWorks lang={lang} />
    <Areas lang={lang} settings={settings} />
    <LatestPosts lang={lang} posts={recentPosts} />
    <Testimonials lang={lang} />
    <FAQ lang={lang} settings={settings} />
    <CTABanner lang={lang} settings={settings} />
  </main>
  <WhatsAppButton lang={lang} settings={settings} />
  <Footer lang={lang} settings={settings} />
</Layout>
