      if (mode !== 'image') itemPreviewWrap?.classList.add('hidden');
      if (mode !== 'video-upload') videoPreviewWrap?.classList.add('hidden');
    }
    typeSelect?.addEventListener('change', syncMediaTypeFields);
    syncMediaTypeFields();

    itemFileInput?.addEventListener('change', () => {
      const file = itemFileInput.files?.[0];
      if (!file) return;
      if (previewObjectUrl) URL.revokeObjectURL(previewObjectUrl);
      previewObjectUrl = URL.createObjectURL(file);
      if (itemFileLabel) itemFileLabel.textContent = file.name;
      if (itemPreviewImg) itemPreviewImg.src = previewObjectUrl;
      if (itemPreviewMeta) {
        itemPreviewMeta.textContent = `${file.name} (${Math.round(file.size / 1024)} KB قبل الضغط)`;
      }
      itemPreviewWrap?.classList.remove('hidden');
    });

    itemVideoInput?.addEventListener('change', async () => {
      const file = itemVideoInput.files?.[0];
      if (!file) return;

      const maxMB = 35;
      if (file.size > maxMB * 1024 * 1024) {
        showToast(`حجم الفيديو (${(file.size / (1024 * 1024)).toFixed(1)} ميجابايت) يتجاوز الحد الأقصى (${maxMB} ميجابايت).`, true);
        itemVideoInput.value = '';
        if (itemVideoLabel) itemVideoLabel.textContent = 'اختر ملف فيديو (MP4, WebM)...';
        videoPreviewWrap?.classList.add('hidden');
        return;
      }

      if (videoPreviewObjectUrl) URL.revokeObjectURL(videoPreviewObjectUrl);
      videoPreviewObjectUrl = URL.createObjectURL(file);
      if (itemVideoLabel) itemVideoLabel.textContent = file.name;
      if (videoPreviewPlayer) {
        videoPreviewPlayer.src = videoPreviewObjectUrl;
        videoPreviewPlayer.load();
      }
      if (videoPreviewMeta) {
        videoPreviewMeta.textContent = `${file.name} (${(file.size / (1024 * 1024)).toFixed(2)} MB)`;
      }
      videoPreviewWrap?.classList.remove('hidden');

      showToast('جاري استخراج صورة مصغرة تلقائياً من الفيديو...');
      extractedVideoThumb = await captureVideoThumbnail(file);
      if (extractedVideoThumb) {
        showToast('تم استخراج صورة مصغرة للفيديو تلقائياً ✓');
      }
    });

    // Replace photo directly on an existing gallery item
    const replaceInput = document.getElementById('replace-photo-input');
    let replaceTargetIndex = -1;

    function triggerReplacePhoto(index) {
      replaceTargetIndex = index;
      if (replaceInput) {
        replaceInput.value = '';
        replaceInput.click();
      }
    }

    replaceInput?.addEventListener('change', async () => {
      const file = replaceInput.files?.[0];
      if (!file || replaceTargetIndex < 0 || !mediaData.items[replaceTargetIndex]) return;
      const targetIndex = replaceTargetIndex;
      replaceTargetIndex = -1;

      showToast('جاري ضغط ورفع الصورة الجديدة...');
      try {
        const uploadedUrl = await uploadImageFile(file);
        const target = mediaData.items[targetIndex];
        if (target.type === 'video') {
          target.thumbnail = uploadedUrl;
        } else {
          target.src = uploadedUrl;
          target.thumbnail = uploadedUrl;
        }
        await saveState('تم تغيير الصورة وتحديث المعرض لكل الزوار.');
      } catch (err) {
        showToast(err instanceof Error ? err.message : 'فشل تغيير الصورة.', true);
      }
    });

    const addForm = document.getElementById('add-media-form');
    const addSubmitBtn = document.getElementById('add-media-submit');
    addForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const rawType = typeSelect.value;
      const category = document.getElementById('item-category').value;
      const title = document.getElementById('item-title').value.trim();
      const titleEn = document.getElementById('item-title-en').value.trim();
      const desc = document.getElementById('item-desc').value.trim();

      let src = '';
      let thumb = '';
      let finalType = 'image';

      if (addSubmitBtn) addSubmitBtn.disabled = true;
      try {
        if (rawType === 'image') {
          finalType = 'image';
          const file = itemFileInput?.files?.[0];
          if (!file) {
            showToast('يرجى اختيار صورة من جهازك أولاً.', true);
            return;
          }
          showToast('جاري ضغط ورفع الصورة...');
          src = await uploadImageFile(file);
          thumb = src;
        } else if (rawType === 'video-upload') {
          finalType = 'video';
          const videoFile = itemVideoInput?.files?.[0];
          if (!videoFile) {
            showToast('يرجى اختيار ملف فيديو من جهازك أولاً.', true);
            return;
          }
          showToast('جاري رفع ملف الفيديو... قد يستغرق لحظات حسب الحجم.');
          src = await uploadMediaFile(videoFile, true);

          const customThumbFile = document.getElementById('item-thumb-file')?.files?.[0];
          if (customThumbFile) {
            showToast('جاري رفع غلاف الفيديو...');
            thumb = await uploadImageFile(customThumbFile);
          } else if (extractedVideoThumb) {
            showToast('جاري رفع الصورة المصغرة المستخرجة...');
            thumb = await uploadImageFile(extractedVideoThumb);
          } else {
            thumb = '/media/truck-loading-cairo.jpg';
          }
        } else {
          finalType = 'video';
          src = itemSrcInput.value.trim();
          if (!src) {
            showToast('يرجى إدخال رابط يوتيوب.', true);
            return;
          }
          if (src.includes('watch?v=')) {
            src = src.replace('watch?v=', 'embed/');
          }
          const thumbFile = document.getElementById('item-thumb-file')?.files?.[0];
          thumb = thumbFile ? await uploadImageFile(thumbFile) : '/media/truck-loading-cairo.jpg';
        }

        mediaData.items.unshift({
          id: Date.now().toString(),
          type: finalType,
          src,
          thumbnail: thumb,
          category,
          title,
          titleEn: titleEn || title,
          alt: title,
          altEn: titleEn || title,
          desc,
          descEn: desc,
        });
        await saveState(finalType === 'video' ? 'تم رفع الفيديو وإضافته إلى المعرض بنجاح.' : 'تم رفع الصورة وإضافتها إلى المعرض بنجاح.');
        addForm.reset();
        syncMediaTypeFields();
        if (itemFileLabel) itemFileLabel.textContent = 'اختر صورة من الهاتف أو الكمبيوتر...';
        if (itemVideoLabel) itemVideoLabel.textContent = 'اختر ملف فيديو (MP4, WebM)...';
        itemPreviewWrap?.classList.add('hidden');
        videoPreviewWrap?.classList.add('hidden');
        if (videoPreviewPlayer) videoPreviewPlayer.src = '';
        extractedVideoThumb = null;
      } catch (err) {
        showToast(err instanceof Error ? err.message : 'فشل إضافة الوسائط.', true);
      } finally {
        if (addSubmitBtn) addSubmitBtn.disabled = false;
      }
    });

    // =========================================================
    // BLOG MANAGEMENT ENGINE
    // =========================================================
    let blogData = Array.isArray(initialBlogPosts) ? JSON.parse(JSON.stringify(initialBlogPosts)) : [];
    const blogListContainer = document.getElementById('blog-posts-list');
    const blogModal = document.getElementById('blog-post-modal');
    const blogForm = document.getElementById('blog-post-form');
    const blogFilterLang = document.getElementById('blog-filter-lang');
    const blogFilterCat = document.getElementById('blog-filter-cat');
    const blogSearchInput = document.getElementById('blog-search-input');
    const faqContainer = document.getElementById('faq-items-container');

    const statBlogTotal = document.getElementById('stat-blog-total');
    const statBlogPublished = document.getElementById('stat-blog-published');
    const statBlogDrafts = document.getElementById('stat-blog-drafts');
    const statBlogViews = document.getElementById('stat-blog-views');

    function updateBlogStats() {
      if (statBlogTotal) statBlogTotal.textContent = String(blogData.length);
      const pubCount = blogData.filter((p) => p.published).length;
      if (statBlogPublished) statBlogPublished.textContent = String(pubCount);
      if (statBlogDrafts) statBlogDrafts.textContent = String(blogData.length - pubCount);
      const totalViews = blogData.reduce((sum, p) => sum + (p.views || 0), 0);
      if (statBlogViews) statBlogViews.textContent = totalViews.toLocaleString('ar-EG');
    }

    function renderBlogPosts() {
      if (!blogListContainer) return;
      updateBlogStats();

      const langFilter = blogFilterLang?.value || 'all';
      const catFilter = blogFilterCat?.value || 'all';
      const searchQuery = (blogSearchInput?.value || '').toLowerCase().trim();

      let filtered = blogData.filter((post) => {
        if (langFilter !== 'all' && post.lang !== langFilter) return false;
        if (catFilter !== 'all' && post.category !== catFilter) return false;
        if (searchQuery) {
          const matchTitle = (post.title || '').toLowerCase().includes(searchQuery);
          const matchSlug = (post.slug || '').toLowerCase().includes(searchQuery);
          if (!matchTitle && !matchSlug) return false;
        }
        return true;
      });

      if (filtered.length === 0) {
        blogListContainer.innerHTML = `
          <div class="bg-slate-900/60 border border-white/10 rounded-2xl p-8 text-center text-slate-400 text-sm">
            لا توجد مقالات مطابقة لمعايير البحث والفلترة.
          </div>
        `;
        return;
      }

      blogListContainer.innerHTML = filtered
        .map((post) => {
          const isAr = post.lang === 'ar';
          const postLink = isAr ? `/blog/${post.slug}` : `/en/blog/${post.slug}`;
          const isPublished = post.published !== false;

          return `
            <div class="bg-slate-900/75 border border-white/10 rounded-2xl p-4 sm:p-5 flex flex-col md:flex-row items-start md:items-center justify-between gap-4 hover:border-white/20 transition-all duration-200">
              <div class="flex items-start sm:items-center gap-3.5 min-w-0 flex-1">
                <img
                  src="${post.coverImage || '/media/truck-loading-cairo.webp'}"
                  alt="${post.title}"
                  class="w-16 h-12 sm:w-20 sm:h-14 rounded-xl object-cover bg-slate-800 shrink-0 border border-white/10"
                />
                <div class="min-w-0 flex-1">
                  <div class="flex flex-wrap items-center gap-2 mb-1">
                    <span class="text-[11px] font-bold px-2 py-0.5 rounded-md ${isAr ? 'bg-emerald-500/20 text-emerald-300 border border-emerald-500/30' : 'bg-sky-500/20 text-sky-300 border border-sky-500/30'}">
                      ${isAr ? 'عربي' : 'English'}
                    </span>
                    <span class="text-[11px] font-semibold text-slate-400 bg-white/5 px-2 py-0.5 rounded-md">
                      ${post.category}
                    </span>
                    <span class="text-[11px] font-semibold px-2 py-0.5 rounded-md ${isPublished ? 'bg-emerald-500/15 text-emerald-400' : 'bg-amber-500/15 text-amber-400'}">
                      ${isPublished ? 'منشور علناً' : 'مسودة غير منشورة'}
                    </span>
                    <span class="text-[11px] text-slate-400">
                      • ${post.readTime || '5 دقائق'}
                    </span>
                    <span class="text-[11px] text-slate-400">
                      • ${(post.views || 0).toLocaleString()} قراءة
                    </span>
                  </div>
                  <h3 class="text-sm font-bold text-white truncate max-w-xl">
                    ${post.title}
                  </h3>
                  <div class="text-[11px] text-slate-400 font-mono mt-0.5 truncate max-w-md" dir="ltr">
                    ${postLink}
                  </div>
                </div>
              </div>

              <div class="flex items-center gap-2 self-end md:self-center shrink-0">
                <a
                  href="${postLink}"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="p-2 sm:px-3 sm:py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white text-xs font-bold border border-white/10 transition-colors inline-flex items-center gap-1.5"
                  title="معاينة المقال"
                >
                  <span>عرض</span>
                </a>

                <button
                  type="button"
                  data-blog-toggle-id="${post.id}"
                  class="p-2 sm:px-3 sm:py-2 rounded-xl ${isPublished ? 'bg-amber-500/20 text-amber-300 hover:bg-amber-500/30' : 'bg-emerald-500/20 text-emerald-300 hover:bg-emerald-500/30'} text-xs font-bold transition-colors"
                >
                  ${isPublished ? 'إلغاء النشر' : 'نشر'}
                </button>

                <button
                  type="button"
                  data-blog-edit-id="${post.id}"
                  class="p-2 sm:px-3 sm:py-2 rounded-xl bg-accent-500/20 hover:bg-accent-500/30 text-accent-300 text-xs font-bold border border-accent-400/25 transition-colors"
                >
                  تعديل
                </button>

                <button
                  type="button"
                  data-blog-delete-id="${post.id}"
                  class="p-2 sm:px-2.5 sm:py-2 rounded-xl bg-rose-500/20 hover:bg-rose-500/30 text-rose-300 text-xs font-bold border border-rose-500/25 transition-colors"
                  title="حذف المقال"
                >
                  حذف
                </button>
              </div>
            </div>
          `;
        })
        .join('');

      // Attach row actions
      blogListContainer.querySelectorAll('[data-blog-edit-id]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const id = btn.getAttribute('data-blog-edit-id');
          const post = blogData.find((p) => p.id === id);
          if (post) openBlogModal(post);
        });
      });

      blogListContainer.querySelectorAll('[data-blog-delete-id]').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const id = btn.getAttribute('data-blog-delete-id');
          const post = blogData.find((p) => p.id === id);
          if (!post) return;
          if (confirm(`هل أنت متأكد من حذف مقال "${post.title}"؟`)) {
            await deletePost(id);
          }
        });
      });

      blogListContainer.querySelectorAll('[data-blog-toggle-id]').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const id = btn.getAttribute('data-blog-toggle-id');
          const post = blogData.find((p) => p.id === id);
          if (!post) return;
          post.published = !post.published;
          await savePostData(post, `تم ${post.published ? 'نشر' : 'تعطيل نشر'} المقال بنجاح.`);
        });
      });
    }

    function renderFaqItems(faqs = []) {
      if (!faqContainer) return;
      faqContainer.innerHTML = '';
      faqs.forEach((faq, index) => {
        const itemDiv = document.createElement('div');
        itemDiv.className = 'p-3 bg-slate-800/80 rounded-xl border border-white/10 space-y-2 relative';
        itemDiv.innerHTML = `
          <div class="flex items-center justify-between">
            <span class="text-[11px] font-bold text-accent-300">سؤال شائع #${index + 1}</span>
            <button type="button" data-faq-remove="${index}" class="text-rose-400 hover:text-rose-300 text-xs font-bold">حذف</button>
          </div>
          <input type="text" data-faq-q="${index}" value="${faq.question || ''}" placeholder="نص السؤال..." class="w-full bg-slate-900 text-white text-xs px-3 py-1.5 rounded-lg border border-white/10 outline-none" />
          <textarea data-faq-a="${index}" rows="2" placeholder="نص الإجابة التفصيلية..." class="w-full bg-slate-900 text-white text-xs p-2 rounded-lg border border-white/10 outline-none leading-relaxed">${faq.answer || ''}</textarea>
        `;
        faqContainer.appendChild(itemDiv);
      });

      faqContainer.querySelectorAll('[data-faq-remove]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const idx = Number(btn.getAttribute('data-faq-remove'));
          currentModalFaqs.splice(idx, 1);
          renderFaqItems(currentModalFaqs);
        });
      });
    }

    let currentModalFaqs = [];

    document.getElementById('add-faq-item-btn')?.addEventListener('click', () => {
      // Sync current DOM inputs back into array first
      syncFaqFromDom();
      currentModalFaqs.push({ question: '', answer: '' });
      renderFaqItems(currentModalFaqs);
    });

    function syncFaqFromDom() {
      if (!faqContainer) return;
      const count = currentModalFaqs.length;
      for (let i = 0; i < count; i++) {
        const qInput = faqContainer.querySelector(`[data-faq-q="${i}"]`);
        const aInput = faqContainer.querySelector(`[data-faq-a="${i}"]`);
        if (qInput && aInput) {
          currentModalFaqs[i] = {
            question: qInput.value.trim(),
            answer: aInput.value.trim(),
          };
        }
      }
    }

    function openBlogModal(post = null) {
      if (!blogModal || !blogForm) return;
      const modalTitle = document.getElementById('blog-modal-title');
      const idInput = document.getElementById('blog-field-id');
      const langInput = document.getElementById('blog-field-lang');
      const categoryInput = document.getElementById('blog-field-category');
      const readTimeInput = document.getElementById('blog-field-readtime');
      const titleInput = document.getElementById('blog-field-title');
      const slugInput = document.getElementById('blog-field-slug');
      const coverInput = document.getElementById('blog-field-cover');
      const excerptInput = document.getElementById('blog-field-excerpt');
      const tagsInput = document.getElementById('blog-field-tags');
      const contentInput = document.getElementById('blog-field-content');
      const publishedInput = document.getElementById('blog-field-published');

      if (post) {
        if (modalTitle) modalTitle.textContent = 'تعديل المقال';
        if (idInput) idInput.value = post.id || '';
        if (langInput) langInput.value = post.lang || 'ar';
        if (categoryInput) categoryInput.value = post.category || 'tips';
        if (readTimeInput) readTimeInput.value = post.readTime || '5 دقائق';
        if (titleInput) titleInput.value = post.title || '';
        if (slugInput) slugInput.value = post.slug || '';
        if (coverInput) coverInput.value = post.coverImage || '';
        if (excerptInput) excerptInput.value = post.excerpt || '';
        if (tagsInput) tagsInput.value = Array.isArray(post.tags) ? post.tags.join(', ') : (post.tags || '');
        if (contentInput) contentInput.value = post.content || '';
        if (publishedInput) publishedInput.checked = post.published !== false;
        currentModalFaqs = Array.isArray(post.faq) ? JSON.parse(JSON.stringify(post.faq)) : [];
      } else {
        if (modalTitle) modalTitle.textContent = 'إضافة مقال جديد';
        blogForm.reset();
        if (idInput) idInput.value = '';
        if (langInput) langInput.value = 'ar';
        if (categoryInput) categoryInput.value = 'pricing';
        if (readTimeInput) readTimeInput.value = '5 دقائق';
        if (coverInput) coverInput.value = '/media/truck-loading-cairo.webp';
        if (publishedInput) publishedInput.checked = true;
        currentModalFaqs = [
          { question: '', answer: '' }
        ];
      }

      renderFaqItems(currentModalFaqs);
      blogModal.showModal();
    }

    function closeBlogModal() {
      if (blogModal) blogModal.close();
    }

    document.getElementById('new-blog-post-btn')?.addEventListener('click', () => openBlogModal(null));
    document.getElementById('close-blog-modal-btn')?.addEventListener('click', closeBlogModal);
    document.getElementById('cancel-blog-btn')?.addEventListener('click', closeBlogModal);

    // Auto-generate slug from title
    document.getElementById('blog-field-title')?.addEventListener('input', (e) => {
      const slugInput = document.getElementById('blog-field-slug');
      const idInput = document.getElementById('blog-field-id');
      if (slugInput && !idInput?.value) {
        const val = e.target.value.trim().toLowerCase()
          .replace(/[\s_]+/g, '-')
          .replace(/[^a-z0-9\u0600-\u06FF-]/g, '')
          .slice(0, 80);
        slugInput.value = val;
      }
    });

    // Form submission
    blogForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      syncFaqFromDom();

      const id = document.getElementById('blog-field-id')?.value || undefined;
      const lang = document.getElementById('blog-field-lang')?.value || 'ar';
      const category = document.getElementById('blog-field-category')?.value || 'tips';
      const readTime = document.getElementById('blog-field-readtime')?.value || '5 دقائق';
      const title = document.getElementById('blog-field-title')?.value.trim();
      const slug = document.getElementById('blog-field-slug')?.value.trim();
      const coverImage = document.getElementById('blog-field-cover')?.value.trim() || '/media/truck-loading-cairo.webp';
      const excerpt = document.getElementById('blog-field-excerpt')?.value.trim() || '';
      const tags = document.getElementById('blog-field-tags')?.value.split(',').map((t) => t.trim()).filter(Boolean) || [];
      const content = document.getElementById('blog-field-content')?.value || '';
      const published = document.getElementById('blog-field-published')?.checked !== false;

      if (!title || !slug) {
        showToast('يرجى كتابة عنوان المقال والرابط الدائم (Slug).', true);
        return;
      }

      const validFaqs = currentModalFaqs.filter((f) => f.question && f.answer);

      const payload = {
        id,
        lang,
        category,
        readTime,
        title,
        slug,
        coverImage,
        excerpt,
        tags,
        content,
        published,
        faq: validFaqs,
      };

      await savePostData(payload, id ? 'تم تحديث المقال بنجاح.' : 'تم إنشاء ونشر المقال الجديد بنجاح.');
      closeBlogModal();
    });

    async function savePostData(postPayload, successMsg) {
      const key = getAdminKey();
      if (!key) {
        showToast('يرجى تسجيل الدخول أولاً.', true);
        return;
      }

      try {
        const res = await fetch('/api/blog', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'x-admin-key': key,
          },
          body: JSON.stringify(postPayload),
        });

        const data = await res.json();
        if (!res.ok || !data.ok) {
          throw new Error(data.error || 'فشل حفظ المقال.');
        }

        const saved = data.post;
        const existingIdx = blogData.findIndex((p) => p.id === saved.id || p.slug === saved.slug);
        if (existingIdx >= 0) {
          blogData[existingIdx] = saved;
        } else {
          blogData.unshift(saved);
        }

        renderBlogPosts();
        showToast(successMsg);
      } catch (err) {
        showToast(err instanceof Error ? err.message : 'حدث خطأ أثناء حفظ المقال.', true);
      }
    }

    async function deletePost(id) {
      const key = getAdminKey();
      if (!key) return;

      try {
        const res = await fetch(`/api/blog?id=${encodeURIComponent(id)}`, {
          method: 'DELETE',
          headers: {
            'x-admin-key': key,
          },
        });

        const data = await res.json();
        if (!res.ok || !data.ok) {
          throw new Error(data.error || 'فشل حذف المقال.');
        }

        blogData = blogData.filter((p) => p.id !== id);
        renderBlogPosts();
        showToast('تم حذف المقال بنجاح.');
      } catch (err) {
        showToast(err instanceof Error ? err.message : 'تعذر حذف المقال.', true);
      }
    }

    // Filter event listeners
    blogFilterLang?.addEventListener('change', renderBlogPosts);
    blogFilterCat?.addEventListener('change', renderBlogPosts);
    blogSearchInput?.addEventListener('input', renderBlogPosts);

    document.getElementById('reset-default-btn')?.addEventListener('click', () => {
      if (confirm('هل تريد استعادة البيانات الافتراضية وحفظها في قاعدة البيانات؟')) {
        mediaData = JSON.parse(JSON.stringify(defaultMedia));
        saveState('تمت استعادة البيانات الافتراضية في قاعدة البيانات.');
      }
    });

    renderList();
    renderBlogPosts();
  </script>
</body>
</html>
