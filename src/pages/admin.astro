---
import '../styles/global.css';
import defaultMedia from '../data/media.json';
import { SOCIAL_PLATFORMS } from '../utils/settings';
import { getBlogPosts, getMediaItems, getRuntimeEnv, getSiteSettings } from '../utils/db';
import {
  Plus,
  Key,
  CheckCircle,
  Eye,
  Phone,
  MessageCircle,
  Clock,
  Save,
  Sliders,
  ChartBar,
  Images,
  TrendingUp,
  MapPin,
  Globe,
  Calendar,
  RefreshCw,
  Activity,
  BookOpen,
  Video,
} from '@lucide/astro';

export const prerender = false;

const { db } = getRuntimeEnv(Astro.locals);
const [initialSettings, initialMediaItems, initialBlogPosts] = await Promise.all([
  getSiteSettings(db),
  getMediaItems(db),
  getBlogPosts(db, { publishedOnly: false }),
]);
const initialMedia = { items: initialMediaItems };
const dbConnected = Boolean(db);
Astro.response.headers.set('Cache-Control', 'no-store');
---

<!doctype html>
<html lang="ar" dir="rtl" class="overflow-x-hidden">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title>شركة الولاء | لوحة تحكم إدارة الموقع والوسائط</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Cairo:wght@700;800&family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&family=JetBrains+Mono:wght@500;700&display=swap"
    rel="stylesheet"
  />
  <style>
    body { font-family: 'IBM Plex Sans Arabic', 'Cairo', system-ui, sans-serif; }
    h1, h2, h3 { font-family: 'Cairo', 'IBM Plex Sans Arabic', system-ui, sans-serif; }
    code, pre { font-family: 'JetBrains Mono', monospace; }

    @keyframes toast-slide-in {
      from {
        opacity: 0;
        transform: translateY(-12px) scale(0.98);
      }
      to {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
    }

    @keyframes toast-progress {
      from { transform: scaleX(1); }
      to { transform: scaleX(0); }
    }

    @keyframes panel-fade-in {
      from {
        opacity: 0;
        transform: translateY(8px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .toast-animate {
      animation: toast-slide-in 0.25s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .toast-progress-bar {
      transform-origin: right center;
      animation: toast-progress 4s linear forwards;
    }

    .tab-panel-animate {
      animation: panel-fade-in 0.24s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .no-scrollbar::-webkit-scrollbar {
      display: none;
    }
    .no-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
  </style>
</head>
<body class="dark-surface bg-[#050d1a] text-slate-100 min-h-screen overflow-x-hidden relative selection:bg-accent-400/30 selection:text-accent-200">
  <!-- Subtle ambient backdrop glow -->
  <div class="pointer-events-none fixed inset-0 overflow-hidden z-0" aria-hidden="true">
    <div class="absolute -top-40 start-1/4 w-[520px] h-[520px] rounded-full bg-accent-500/5 blur-3xl"></div>
    <div class="absolute top-1/3 -end-32 w-[420px] h-[420px] rounded-full bg-sky-500/5 blur-3xl"></div>
  </div>

  <!-- Authentication Guard Gate -->
  <div id="auth-gate" class="fixed inset-0 z-50 bg-[#040a15]/95 backdrop-blur-md flex items-center justify-center p-4">
    <div class="max-w-md w-full bg-slate-900/90 border border-white/15 rounded-2xl p-8 shadow-2xl text-center relative overflow-hidden">
      <div class="absolute inset-x-0 top-0 h-1 bg-gradient-to-r from-accent-400/20 via-accent-400 to-accent-400/20"></div>
      <div class="w-14 h-14 bg-gradient-to-br from-accent-500/25 to-accent-700/10 border border-accent-400/30 text-accent-300 rounded-2xl flex items-center justify-center mx-auto mb-5 shadow-lg">
        <Key class="w-7 h-7" aria-hidden="true" />
      </div>
      <h1 class="text-2xl font-extrabold text-white mb-2">لوحة تحكم الإدارة</h1>
      <p class="text-sm text-slate-300 mb-6 leading-relaxed">
        متابعة إحصائيات الزيارات، تعديل أرقام التواصل، وإدارة معرض الصور والفيديو. أدخل مفتاح الدخول للمتابعة:
      </p>

      <form id="auth-form" class="space-y-4">
        <label for="access-key-input" class="visually-hidden">مفتاح الدخول</label>
        <input
          type="password"
          id="access-key-input"
          dir="ltr"
          autocomplete="current-password"
          placeholder="أدخل مفتاح الدخول (الافتراضي: mover-dev-2024)"
          class="w-full bg-slate-950/80 border border-white/15 rounded-xl px-4 py-3.5 text-sm text-center text-white placeholder-slate-400 transition-all duration-200 focus:border-accent-300 focus:ring-2 focus:ring-accent-300/30 outline-none"
          required
        />
        <button
          type="submit"
          class="w-full bg-gradient-to-l from-accent-500 to-accent-600 hover:from-accent-400 hover:to-accent-500 active:scale-[0.98] text-white font-bold py-3.5 rounded-xl shadow-lg shadow-accent-900/30 transition-all duration-200 min-h-[48px]"
        >
          الدخول إلى لوحة التحكم
        </button>
      </form>
      <div id="auth-error" role="alert" class="hidden text-rose-300 text-xs mt-3 font-semibold bg-rose-950/60 border border-rose-500/30 rounded-lg py-2 px-3">
        مفتاح الدخول غير صحيح، يرجى المحاولة مرة أخرى.
      </div>
    </div>
  </div>

  <!-- Main Developer Dashboard -->
  <div id="dashboard" class="hidden min-h-screen w-full max-w-full min-w-0 overflow-x-hidden flex flex-col relative z-10">
    <!-- Top Bar -->
    <header class="bg-[#071224]/85 backdrop-blur-xl sticky top-0 z-40 w-full max-w-full min-w-0">
      <div class="max-w-7xl w-full min-w-0 mx-auto px-3.5 sm:px-6 lg:px-8 py-3.5 flex flex-wrap items-center justify-between gap-3">
        <div class="flex items-center gap-3 min-w-0">
          <img
            src="/logo.jpg"
            alt="شركة الولاء"
            width="44"
            height="44"
            class="w-10 h-10 sm:w-11 sm:h-11 rounded-xl bg-white p-1 object-contain shrink-0 ring-1 ring-white/20 shadow-md"
          />
          <div class="min-w-0">
            <div class="font-extrabold text-white text-base sm:text-lg flex items-center gap-2 flex-wrap">
              <span>شركة الولاء</span>
              <span class="text-[10px] sm:text-[11px] bg-accent-500/15 text-accent-300 border border-accent-400/30 px-2 py-0.5 rounded-full font-mono font-bold tracking-wide">ADMIN</span>
            </div>
            <div class="text-[11px] sm:text-xs text-slate-300 flex flex-wrap items-center gap-x-2 gap-y-0.5 mt-0.5">
              <span>لوحة إدارة الموقع والزيارات</span>
              <span class="text-slate-600 hidden sm:inline">•</span>
              <span class={`inline-flex items-center gap-1.5 font-semibold ${dbConnected ? 'text-emerald-300' : 'text-amber-300'}`}>
                <span class="relative flex h-2 w-2">
                  <span class={`animate-ping absolute inline-flex h-full w-full rounded-full opacity-75 ${dbConnected ? 'bg-emerald-400' : 'bg-amber-400'}`}></span>
                  <span class={`relative inline-flex rounded-full h-2 w-2 ${dbConnected ? 'bg-emerald-400' : 'bg-amber-400'}`}></span>
                </span>
                <span>{dbConnected ? 'D1 متصل' : 'وضع محلي بدون D1'}</span>
              </span>
            </div>
          </div>
        </div>

        <div class="flex flex-wrap items-center gap-2">
          <a
            href="/"
            target="_blank"
            class="inline-flex items-center gap-1.5 text-xs font-bold text-slate-200 hover:text-white bg-slate-800/80 hover:bg-slate-700/90 active:scale-[0.98] px-3 sm:px-4 py-2 rounded-xl transition-all duration-200 border border-white/10 min-h-[40px]"
          >
            <Eye class="w-4 h-4 text-sky-300" aria-hidden="true" />
            <span>معاينة الموقع</span>
          </a>
          <button
            type="button"
            id="lock-btn"
            class="text-xs font-bold text-rose-200 hover:text-white bg-rose-950/60 hover:bg-rose-800/80 active:scale-[0.98] px-3 sm:px-4 py-2 rounded-xl border border-rose-500/30 transition-all duration-200 min-h-[40px]"
          >
            قفل اللوحة
          </button>
        </div>
      </div>

      <!-- Gradient Bottom Divider -->
      <div class="h-px bg-gradient-to-r from-transparent via-accent-400/35 to-transparent"></div>

      <!-- Tab Navigation Bar -->
      <div class="max-w-7xl w-full min-w-0 mx-auto px-3.5 sm:px-6 lg:px-8 py-3">
        <nav
          role="tablist"
          aria-label="أقسام لوحة التحكم"
          class="flex flex-wrap sm:flex-nowrap items-center gap-1.5 sm:gap-2 w-full min-w-0 p-1.5 rounded-2xl bg-slate-900/75 backdrop-blur-xl border border-white/10 shadow-lg"
        >
          <button
            type="button"
            role="tab"
            id="tab-btn-traffic"
            data-tab="traffic"
            aria-selected="true"
            aria-controls="tab-panel-traffic"
            class="tab-btn relative flex-1 sm:flex-initial flex items-center justify-center sm:justify-start gap-1.5 sm:gap-2 px-3 sm:px-4 py-2.5 rounded-xl text-xs sm:text-sm font-bold whitespace-nowrap transition-all duration-200 active:scale-[0.98] min-h-[44px]"
          >
            <ChartBar class="w-4 h-4 shrink-0" aria-hidden="true" />
            <span>إحصائيات الزيارات</span>
          </button>

          <button
            type="button"
            role="tab"
            id="tab-btn-settings"
            data-tab="settings"
            aria-selected="false"
            aria-controls="tab-panel-settings"
            class="tab-btn relative flex-1 sm:flex-initial flex items-center justify-center sm:justify-start gap-1.5 sm:gap-2 px-3 sm:px-4 py-2.5 rounded-xl text-xs sm:text-sm font-bold whitespace-nowrap transition-all duration-200 active:scale-[0.98] min-h-[44px]"
          >
            <Sliders class="w-4 h-4 shrink-0" aria-hidden="true" />
            <span>إعدادات التواصل</span>
          </button>

          <button
            type="button"
            role="tab"
            id="tab-btn-media"
            data-tab="media"
            aria-selected="false"
            aria-controls="tab-panel-media"
            class="tab-btn relative flex-1 sm:flex-initial flex items-center justify-center sm:justify-start gap-1.5 sm:gap-2 px-3 sm:px-4 py-2.5 rounded-xl text-xs sm:text-sm font-bold whitespace-nowrap transition-all duration-200 active:scale-[0.98] min-h-[44px]"
          >
            <Images class="w-4 h-4 shrink-0" aria-hidden="true" />
            <span>إدارة المعرض</span>
          </button>

          <button
            type="button"
            role="tab"
            id="tab-btn-blog"
            data-tab="blog"
            aria-selected="false"
            aria-controls="tab-panel-blog"
            class="tab-btn relative flex-1 sm:flex-initial flex items-center justify-center sm:justify-start gap-1.5 sm:gap-2 px-3 sm:px-4 py-2.5 rounded-xl text-xs sm:text-sm font-bold whitespace-nowrap transition-all duration-200 active:scale-[0.98] min-h-[44px]"
          >
            <BookOpen class="w-4 h-4 shrink-0" aria-hidden="true" />
            <span>المقالات والمدونة</span>
          </button>
        </nav>
      </div>
    </header>

    <!-- Floating Toast Notification -->
    <div
      id="admin-toast"
      role="status"
      aria-live="polite"
      class="hidden fixed top-20 inset-x-4 mx-auto max-w-lg z-50 rounded-2xl bg-emerald-950/95 backdrop-blur-xl border border-emerald-500/40 text-emerald-100 px-4 py-3.5 text-sm font-semibold shadow-2xl overflow-hidden"
    >
      <div class="flex items-center gap-2.5">
        <CheckCircle class="w-4 h-4 text-emerald-300 shrink-0" aria-hidden="true" />
        <span id="admin-toast-text" class="flex-1"></span>
      </div>
      <div id="admin-toast-bar" class="toast-progress-bar absolute inset-x-0 bottom-0 h-0.5 bg-emerald-400"></div>
    </div>

    <!-- Main Container -->
    <main class="flex-1 max-w-7xl w-full min-w-0 mx-auto px-3.5 sm:px-6 lg:px-8 py-5 sm:py-8">

      <!-- ========================================================= -->
      <!-- TAB 1: TRAFFIC ANALYTICS                                  -->
      <!-- ========================================================= -->
      <div
        id="tab-panel-traffic"
        role="tabpanel"
        aria-labelledby="tab-btn-traffic"
        data-tab-panel="traffic"
        class="space-y-6 tab-panel-animate min-w-0"
      >
        <!-- Traffic Toolbar -->
        <section class="bg-slate-900/65 backdrop-blur-md border border-white/10 rounded-2xl p-4 sm:p-6 flex flex-col md:flex-row md:items-center justify-between gap-4 relative overflow-hidden min-w-0">
          <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-sky-400/40 to-transparent"></div>
          <div class="flex items-start gap-3 min-w-0">
            <div class="w-10 h-10 sm:w-11 sm:h-11 rounded-xl bg-gradient-to-br from-sky-500/20 to-indigo-500/10 border border-sky-400/25 text-sky-300 flex items-center justify-center shrink-0">
              <Activity class="w-5 h-5" aria-hidden="true" />
            </div>
            <div class="min-w-0">
              <h2 class="text-base sm:text-lg font-extrabold text-white">حركة الزيارات والمدن</h2>
              <p class="text-xs text-slate-300 mt-1">
                تتبع عدد الزيارات اليومية وتوزيع الزوار حسب المدن والصفحات الأكثر زيارة
              </p>
            </div>
          </div>

          <div class="flex flex-wrap items-center gap-2.5 w-full md:w-auto">
            <div class="flex flex-wrap items-center gap-1 p-1 rounded-xl bg-slate-950/80 border border-white/10 w-full sm:w-auto justify-between sm:justify-start" role="group" aria-label="الفترة الزمنية">
              <button type="button" data-range="today" class="range-btn flex-1 sm:flex-initial px-2.5 sm:px-3 py-2 rounded-lg text-xs font-bold transition-all duration-200 min-h-[38px] text-slate-300 hover:text-white">اليوم</button>
              <button type="button" data-range="7d" class="range-btn flex-1 sm:flex-initial px-2.5 sm:px-3 py-2 rounded-lg text-xs font-bold transition-all duration-200 min-h-[38px] bg-accent-500/20 text-accent-200 border border-accent-400/30">7 أيام</button>
              <button type="button" data-range="30d" class="range-btn flex-1 sm:flex-initial px-2.5 sm:px-3 py-2 rounded-lg text-xs font-bold transition-all duration-200 min-h-[38px] text-slate-300 hover:text-white">30 يوماً</button>
              <button type="button" data-range="all" class="range-btn flex-1 sm:flex-initial px-2.5 sm:px-3 py-2 rounded-lg text-xs font-bold transition-all duration-200 min-h-[38px] text-slate-300 hover:text-white">الكل</button>
            </div>

            <button
              type="button"
              id="refresh-traffic-btn"
              class="inline-flex items-center justify-center gap-1.5 bg-slate-800/90 hover:bg-slate-700 active:scale-[0.98] text-slate-100 text-xs font-bold px-3.5 py-2.5 rounded-xl border border-white/10 transition-all duration-200 min-h-[42px] w-full sm:w-auto"
            >
              <RefreshCw id="refresh-traffic-icon" class="w-3.5 h-3.5 text-sky-300" aria-hidden="true" />
              <span>تحديث</span>
            </button>
          </div>
        </section>

        <!-- Summary KPI Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          <div class="bg-slate-900/70 border border-white/10 rounded-2xl p-5 hover:-translate-y-0.5 hover:shadow-elevated hover:border-sky-400/30 transition-all duration-200 relative overflow-hidden">
            <div class="absolute -bottom-6 -end-6 w-24 h-24 rounded-full bg-sky-500/10 blur-2xl"></div>
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold text-slate-300">إجمالي الزيارات</span>
              <span class="w-8 h-8 rounded-lg bg-sky-500/15 text-sky-300 flex items-center justify-center border border-sky-400/20">
                <TrendingUp class="w-4 h-4" aria-hidden="true" />
              </span>
            </div>
            <div id="traffic-total" class="text-3xl font-extrabold text-white mt-3 tabular-nums">0</div>
            <div id="traffic-range-label" class="text-[11px] text-slate-400 mt-1">خلال آخر 7 أيام</div>
          </div>

          <div class="bg-slate-900/70 border border-white/10 rounded-2xl p-5 hover:-translate-y-0.5 hover:shadow-elevated hover:border-emerald-400/30 transition-all duration-200 relative overflow-hidden">
            <div class="absolute -bottom-6 -end-6 w-24 h-24 rounded-full bg-emerald-500/10 blur-2xl"></div>
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold text-slate-300">زيارات اليوم</span>
              <span class="w-8 h-8 rounded-lg bg-emerald-500/15 text-emerald-300 flex items-center justify-center border border-emerald-400/20">
                <Calendar class="w-4 h-4" aria-hidden="true" />
              </span>
            </div>
            <div id="traffic-today" class="text-3xl font-extrabold text-emerald-300 mt-3 tabular-nums">0</div>
            <div class="text-[11px] text-slate-400 mt-1">بتوقيت الخادم العالمي (UTC)</div>
          </div>

          <div class="bg-slate-900/70 border border-white/10 rounded-2xl p-5 hover:-translate-y-0.5 hover:shadow-elevated hover:border-amber-400/30 transition-all duration-200 relative overflow-hidden">
            <div class="absolute -bottom-6 -end-6 w-24 h-24 rounded-full bg-amber-500/10 blur-2xl"></div>
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold text-slate-300">المدن المسجلة</span>
              <span class="w-8 h-8 rounded-lg bg-amber-500/15 text-amber-300 flex items-center justify-center border border-amber-400/20">
                <Globe class="w-4 h-4" aria-hidden="true" />
              </span>
            </div>
            <div id="traffic-cities-count" class="text-3xl font-extrabold text-amber-300 mt-3 tabular-nums">0</div>
            <div class="text-[11px] text-slate-400 mt-1">مدينة مختلفة حسب الموقع الجغرافي</div>
          </div>

          <div class="bg-slate-900/70 border border-white/10 rounded-2xl p-5 hover:-translate-y-0.5 hover:shadow-elevated hover:border-violet-400/30 transition-all duration-200 relative overflow-hidden">
            <div class="absolute -bottom-6 -end-6 w-24 h-24 rounded-full bg-violet-500/10 blur-2xl"></div>
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold text-slate-300">المدينة الأكثر زيارة</span>
              <span class="w-8 h-8 rounded-lg bg-violet-500/15 text-violet-300 flex items-center justify-center border border-violet-400/20">
                <MapPin class="w-4 h-4" aria-hidden="true" />
              </span>
            </div>
            <div id="traffic-top-city" class="text-xl font-extrabold text-white mt-3 truncate">—</div>
            <div id="traffic-top-city-visits" class="text-[11px] text-slate-400 mt-1">لا توجد بيانات بعد</div>
          </div>
        </div>

        <!-- Daily Visits Chart -->
        <section class="bg-slate-900/65 border border-white/10 rounded-2xl p-5 sm:p-6">
          <div class="flex items-center justify-between gap-4 pb-4 mb-5 border-b border-white/10">
            <div>
              <h3 class="text-base font-extrabold text-white flex items-center gap-2">
                <ChartBar class="w-4 h-4 text-accent-300" aria-hidden="true" />
                <span>الزيارات اليومية</span>
              </h3>
              <p class="text-xs text-slate-400 mt-0.5">توزيع عدد الزيارات على مدار الأيام المختارة</p>
            </div>
            <span id="traffic-chart-peak" class="text-xs font-mono text-slate-300 bg-slate-950/70 border border-white/10 px-3 py-1.5 rounded-lg">أعلى يوم: 0</span>
          </div>

          <div id="traffic-daily-chart" class="space-y-3">
            <div class="py-10 text-center text-xs text-slate-400">جاري تحميل بيانات الزيارات...</div>
          </div>
        </section>

        <!-- Cities Breakdown & Top Pages -->
        <div class="grid grid-cols-1 lg:grid-cols-5 gap-6">
          <!-- Cities Breakdown (3 cols) -->
          <section class="lg:col-span-3 min-w-0 bg-slate-900/65 border border-white/10 rounded-2xl p-4 sm:p-6">
            <div class="flex items-center justify-between gap-4 pb-4 mb-5 border-b border-white/10">
              <div class="min-w-0">
                <h3 class="text-base font-extrabold text-white flex items-center gap-2">
                  <MapPin class="w-4 h-4 text-amber-300 shrink-0" aria-hidden="true" />
                  <span>توزيع الزيارات حسب المدن</span>
                </h3>
                <p class="text-xs text-slate-400 mt-0.5">يتم التعرف على المدينة تلقائياً عبر شبكة Cloudflare عند النشر</p>
              </div>
            </div>

            <div id="traffic-cities-list" class="space-y-3">
              <div class="py-8 text-center text-xs text-slate-400">جاري تحميل قائمة المدن...</div>
            </div>
          </section>

          <!-- Top Pages (2 cols) -->
          <section class="lg:col-span-2 min-w-0 bg-slate-900/65 border border-white/10 rounded-2xl p-4 sm:p-6">
            <div class="flex items-center justify-between gap-4 pb-4 mb-5 border-b border-white/10">
              <div>
                <h3 class="text-base font-extrabold text-white flex items-center gap-2">
                  <Globe class="w-4 h-4 text-emerald-300" aria-hidden="true" />
                  <span>الصفحات الأكثر زيارة</span>
                </h3>
                <p class="text-xs text-slate-400 mt-0.5">مسارات الموقع التي استقبلت أكبر عدد من الزوار</p>
              </div>
            </div>

            <div id="traffic-pages-list" class="space-y-3">
              <div class="py-8 text-center text-xs text-slate-400">جاري تحميل قائمة الصفحات...</div>
            </div>
          </section>
        </div>
      </div>

