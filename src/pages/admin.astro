    async function compressToWebP(file) {
      const bitmap = await createImageBitmap(file);
      const maxDim = 1400;
      const scale = Math.min(1, maxDim / Math.max(bitmap.width, bitmap.height));
      const width = Math.max(1, Math.round(bitmap.width * scale));
      const height = Math.max(1, Math.round(bitmap.height * scale));

      const canvas = document.createElement('canvas');
      canvas.width = width;
      canvas.height = height;
      const ctx = canvas.getContext('2d');
      ctx.drawImage(bitmap, 0, 0, width, height);
      bitmap.close();

      let blob = await new Promise((resolve) => canvas.toBlob(resolve, 'image/webp', 0.84));
      if (!blob) {
        blob = await new Promise((resolve) => canvas.toBlob(resolve, 'image/jpeg', 0.84));
      }
      if (!blob) throw new Error('تعذر ضغط الصورة في المتصفح');
      return blob;
    }

    async function uploadMediaFile(file, isVideo = false) {
      let fileToUpload = file;
      if (!isVideo && file.type && file.type.startsWith('image/')) {
        fileToUpload = await compressToWebP(file);
      }
      const ext = isVideo ? (file.name.split('.').pop() || 'mp4') : (fileToUpload.type === 'image/webp' ? 'webp' : 'jpg');
      const formData = new FormData();
      formData.append('file', fileToUpload, file.name || `media.${ext}`);

      const res = await fetch('/api/upload', {
        method: 'POST',
        headers: { 'x-admin-key': getAdminKey() },
        body: formData,
      });
      const data = await res.json();
      if (!res.ok) {
        throw new Error(data.error || (isVideo ? 'فشل رفع ملف الفيديو' : 'فشل رفع الصورة'));
      }
      return data.url;
    }

    const uploadImageFile = (file) => uploadMediaFile(file, false);

    function captureVideoThumbnail(videoFile) {
      return new Promise((resolve) => {
        const video = document.createElement('video');
        video.preload = 'metadata';
        const objUrl = URL.createObjectURL(videoFile);
        video.src = objUrl;
        video.muted = true;
        video.playsInline = true;

        const cleanup = () => {
          URL.revokeObjectURL(objUrl);
        };

        const timeoutId = setTimeout(() => {
          cleanup();
          resolve(null);
        }, 6000);

        video.onloadeddata = () => {
          video.currentTime = Math.min(0.5, (video.duration || 1) / 2);
        };

        video.onseeked = () => {
          clearTimeout(timeoutId);
          try {
            const canvas = document.createElement('canvas');
            canvas.width = Math.min(video.videoWidth || 800, 1280);
            canvas.height = Math.min(video.videoHeight || 500, 720);
            const ctx = canvas.getContext('2d');
            if (ctx) {
              ctx.drawImage(video, 0, 0, canvas.width, canvas.height);
              canvas.toBlob((blob) => {
                cleanup();
                if (blob) {
                  const thumbFile = new File([blob], 'thumb.webp', { type: 'image/webp' });
                  resolve(thumbFile);
                } else {
                  resolve(null);
                }
              }, 'image/webp', 0.85);
              return;
            }
          } catch (err) {
            console.warn('Could not extract thumbnail canvas:', err);
          }
          cleanup();
          resolve(null);
        };

        video.onerror = () => {
          clearTimeout(timeoutId);
          cleanup();
          resolve(null);
        };
      });
    }

