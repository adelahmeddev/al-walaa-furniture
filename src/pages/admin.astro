    function syncMediaTypeFields() {
      const mode = typeSelect?.value || 'image';
      photoUploadWrap?.classList.toggle('hidden', mode !== 'image');
      videoUploadWrap?.classList.toggle('hidden', mode !== 'video-upload');
      videoUrlWrap?.classList.toggle('hidden', mode !== 'video-youtube');
      videoThumbWrap?.classList.toggle('hidden', mode === 'image');

