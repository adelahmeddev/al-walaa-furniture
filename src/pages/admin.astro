      btn.addEventListener('click', () => {
        const range = btn.dataset.range || '7d';
        loadTrafficData(range);
      });
    });

    refreshTrafficBtn?.addEventListener('click', () => {
      loadTrafficData(currentTrafficRange, true);
    });

