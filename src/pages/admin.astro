  <script define:vars={{ defaultMedia, initialMedia, initialSettings, dbConnected }}>
    const authGate = document.getElementById('auth-gate');
    const dashboard = document.getElementById('dashboard');
    const authForm = document.getElementById('auth-form');
    const accessKeyInput = document.getElementById('access-key-input');
    const authError = document.getElementById('auth-error');
    const lockBtn = document.getElementById('lock-btn');
    const toast = document.getElementById('admin-toast');
    const toastText = document.getElementById('admin-toast-text');
    const toastBar = document.getElementById('admin-toast-bar');
    const SESSION_KEY = 'mover_admin_key';
    const ACTIVE_TAB_KEY = 'mover_admin_active_tab';
    let toastTimer = null;
    let currentTrafficRange = '7d';
    let trafficLoadedOnce = false;

    function showToast(msg, isError = false) {
      if (!toast || !toastText) return;
      toastText.textContent = msg;
      toast.classList.toggle('bg-emerald-950/95', !isError);
      toast.classList.toggle('border-emerald-500/40', !isError);
      toast.classList.toggle('text-emerald-100', !isError);
      toast.classList.toggle('bg-rose-950/95', isError);
      toast.classList.toggle('border-rose-500/40', isError);
      toast.classList.toggle('text-rose-100', isError);
      if (toastBar) {
        toastBar.classList.toggle('bg-emerald-400', !isError);
        toastBar.classList.toggle('bg-rose-400', isError);
        toastBar.classList.remove('toast-progress-bar');
        void toastBar.offsetWidth;
        toastBar.classList.add('toast-progress-bar');
      }
      toast.classList.remove('hidden', 'toast-animate');
      void toast.offsetWidth;
      toast.classList.add('toast-animate');

      if (toastTimer) clearTimeout(toastTimer);
      toastTimer = setTimeout(() => toast.classList.add('hidden'), 4000);
    }

    function getAdminKey() {
      return sessionStorage.getItem(SESSION_KEY) || '';
    }

    // Tab Navigation System
    const VALID_TABS = ['traffic', 'settings', 'media'];
    const tabButtons = Array.from(document.querySelectorAll('.tab-btn'));
    const tabPanels = Array.from(document.querySelectorAll('[data-tab-panel]'));

    function switchTab(tabName, updateHash = true) {
      const target = VALID_TABS.includes(tabName) ? tabName : 'traffic';

      tabButtons.forEach((btn) => {
        const isActive = btn.dataset.tab === target;
        btn.setAttribute('aria-selected', String(isActive));
        btn.classList.toggle('bg-gradient-to-l', isActive);
        btn.classList.toggle('from-accent-500/25', isActive);
        btn.classList.toggle('to-accent-400/15', isActive);
        btn.classList.toggle('text-accent-200', isActive);
        btn.classList.toggle('border', isActive);
        btn.classList.toggle('border-accent-400/35', isActive);
        btn.classList.toggle('shadow-md', isActive);
        btn.classList.toggle('text-slate-300', !isActive);
        btn.classList.toggle('hover:text-white', !isActive);
        btn.classList.toggle('hover:bg-white/5', !isActive);
      });

      tabPanels.forEach((panel) => {
        const isTarget = panel.dataset.tabPanel === target;
        panel.classList.toggle('hidden', !isTarget);
        if (isTarget) {
          panel.classList.remove('tab-panel-animate');
          void panel.offsetWidth;
          panel.classList.add('tab-panel-animate');
        }
      });

      sessionStorage.setItem(ACTIVE_TAB_KEY, target);
      if (updateHash && window.location.hash !== `#${target}`) {
        history.replaceState(null, '', `#${target}`);
      }

      if (target === 'traffic' && getAdminKey() && !trafficLoadedOnce) {
        loadTrafficData(currentTrafficRange);
      }
    }

    tabButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        switchTab(btn.dataset.tab || 'traffic');
      });
    });

    function resolveInitialTab() {
      const hashTab = window.location.hash.replace('#', '').trim();
      if (VALID_TABS.includes(hashTab)) return hashTab;
      const savedTab = sessionStorage.getItem(ACTIVE_TAB_KEY) || '';
      if (VALID_TABS.includes(savedTab)) return savedTab;
      return 'traffic';
    }

    window.addEventListener('hashchange', () => {
      const hashTab = window.location.hash.replace('#', '').trim();
      if (VALID_TABS.includes(hashTab)) {
        switchTab(hashTab, false);
      }
    });

    // Country Code -> Flag Emoji
    function countryCodeToFlag(code) {
      if (!code || code.length !== 2) return '🌍';
      const upper = code.toUpperCase();
      if (!/^[A-Z]{2}$/.test(upper)) return '🌍';
      return String.fromCodePoint(
        ...Array.from(upper).map((char) => 127397 + char.charCodeAt(0))
      );
    }

    const RANGE_LABELS = {
      today: 'زيارات اليوم',
      '7d': 'خلال آخر 7 أيام',
      '30d': 'خلال آخر 30 يوماً',
      all: 'منذ بدء التسجيل',
    };

    const rangeButtons = Array.from(document.querySelectorAll('.range-btn'));
    const refreshTrafficBtn = document.getElementById('refresh-traffic-btn');
    const refreshTrafficIcon = document.getElementById('refresh-traffic-icon');

    function syncRangeButtons(activeRange) {
      rangeButtons.forEach((btn) => {
        const isActive = btn.dataset.range === activeRange;
        btn.classList.toggle('bg-accent-500/20', isActive);
        btn.classList.toggle('text-accent-200', isActive);
        btn.classList.toggle('border', isActive);
        btn.classList.toggle('border-accent-400/30', isActive);
        btn.classList.toggle('text-slate-300', !isActive);
        btn.classList.toggle('hover:text-white', !isActive);
      });
    }

    function formatArabicDate(isoDate) {
      if (!isoDate) return '';
      try {
        const d = new Date(`${isoDate}T00:00:00Z`);
        return d.toLocaleDateString('ar-EG', {
          month: 'short',
          day: 'numeric',
          timeZone: 'UTC',
        });
      } catch {
        return isoDate;
      }
    }

    function formatPageLabel(path) {
      if (path === '/' || path === '') return 'الصفحة الرئيسية (العربية)';
      if (path === '/en' || path === '/en/') return 'الصفحة الإنجليزية (/en)';
      return path;
    }

    function renderTrafficStats(data) {
      const totalEl = document.getElementById('traffic-total');
      const todayEl = document.getElementById('traffic-today');
      const rangeLabelEl = document.getElementById('traffic-range-label');
      const citiesCountEl = document.getElementById('traffic-cities-count');
      const topCityEl = document.getElementById('traffic-top-city');
      const topCityVisitsEl = document.getElementById('traffic-top-city-visits');
      const peakEl = document.getElementById('traffic-chart-peak');

      if (totalEl) totalEl.textContent = Number(data.totalVisits || 0).toLocaleString('en-US');
      if (todayEl) todayEl.textContent = Number(data.todayVisits || 0).toLocaleString('en-US');
      if (rangeLabelEl) rangeLabelEl.textContent = RANGE_LABELS[data.range] || RANGE_LABELS['7d'];
      if (citiesCountEl) citiesCountEl.textContent = Number(data.uniqueCities || 0).toLocaleString('en-US');

      if (topCityEl && topCityVisitsEl) {
        if (data.topCity && data.topCity.visits > 0) {
          const flag = countryCodeToFlag(data.topCity.country);
          const cityName = data.topCity.city || 'زيارات محلية / غير محدد';
          topCityEl.textContent = `${flag} ${cityName}`;
          topCityVisitsEl.textContent = `${Number(data.topCity.visits).toLocaleString('en-US')} زيارة مسجلة`;
        } else {
          topCityEl.textContent = '—';
          topCityVisitsEl.textContent = 'لا توجد بيانات بعد';
        }
      }

      // Render Daily Visits Bar Chart
      const chartContainer = document.getElementById('traffic-daily-chart');
      const daily = Array.isArray(data.dailyVisits) ? data.dailyVisits : [];
      const maxDaily = daily.reduce((max, item) => Math.max(max, Number(item.visits || 0)), 0);
      if (peakEl) peakEl.textContent = `أعلى يوم: ${maxDaily.toLocaleString('en-US')}`;

      if (chartContainer) {
        chartContainer.replaceChildren();
        if (daily.length === 0) {
          const empty = document.createElement('div');
          empty.className = 'py-8 text-center text-xs text-slate-400';
          empty.textContent = 'لا توجد زيارات مسجلة في هذه الفترة حتى الآن.';
          chartContainer.append(empty);
        } else {
          daily.forEach((day) => {
            const visits = Number(day.visits || 0);
            const pct = maxDaily > 0 ? Math.max(visits > 0 ? 6 : 0, Math.round((visits / maxDaily) * 100)) : 0;

            const row = document.createElement('div');
            row.className = 'grid grid-cols-[4.5rem_1fr_2.5rem] sm:grid-cols-[7rem_1fr_4rem] items-center gap-2.5 sm:gap-3';

            const dateLabel = document.createElement('span');
            dateLabel.className = 'text-xs font-medium text-slate-300 truncate';
            dateLabel.textContent = formatArabicDate(day.date);

            const track = document.createElement('div');
            track.className = 'h-3.5 rounded-full bg-slate-950/90 border border-white/5 overflow-hidden';

            const fill = document.createElement('div');
            fill.className = 'h-full rounded-full bg-gradient-to-l from-accent-300 via-accent-400 to-sky-400 transition-all duration-500';
            fill.style.width = `${pct}%`;
            track.append(fill);

            const countLabel = document.createElement('span');
            countLabel.className = 'text-xs font-mono font-bold text-white text-end tabular-nums';
            countLabel.textContent = visits.toLocaleString('en-US');

            row.append(dateLabel, track, countLabel);
            chartContainer.append(row);
          });
        }
      }

      // Render Cities List
      const citiesContainer = document.getElementById('traffic-cities-list');
      const cities = Array.isArray(data.cities) ? data.cities : [];
      const totalCityVisits = cities.reduce((sum, c) => sum + Number(c.visits || 0), 0);

      if (citiesContainer) {
        citiesContainer.replaceChildren();
        if (cities.length === 0) {
          const empty = document.createElement('div');
          empty.className = 'py-8 text-center text-xs text-slate-400';
          empty.textContent = dbConnected
            ? 'لم تُسجّل زيارات بعد. ستظهر المدن هنا بمجرد زيارة الموقع.'
            : 'قاعدة بيانات D1 غير متصلة حالياً — اربط D1 لتسجيل الزيارات والمدن.';
          citiesContainer.append(empty);
        } else {
          const maxCity = Math.max(...cities.map((c) => Number(c.visits || 0)), 1);
          cities.forEach((item) => {
            const visits = Number(item.visits || 0);
            const share = totalCityVisits > 0 ? Math.round((visits / totalCityVisits) * 100) : 0;
            const barWidth = Math.max(4, Math.round((visits / maxCity) * 100));

            const card = document.createElement('div');
            card.className = 'p-3 rounded-xl bg-slate-950/60 border border-white/5 hover:border-white/15 transition-colors space-y-2';

            const topRow = document.createElement('div');
            topRow.className = 'flex items-center justify-between gap-2 text-xs';

            const left = document.createElement('div');
            left.className = 'flex items-center gap-2 min-w-0';

            const flagSpan = document.createElement('span');
            flagSpan.className = 'text-base leading-none shrink-0';
            flagSpan.textContent = countryCodeToFlag(item.country);

            const citySpan = document.createElement('span');
            citySpan.className = 'font-bold text-white truncate';
            citySpan.textContent = item.city || 'زيارة محلية / غير محدد';

            left.append(flagSpan, citySpan);
            if (item.country) {
              const countryBadge = document.createElement('span');
              countryBadge.className = 'text-[10px] font-mono text-slate-300 bg-slate-800/80 px-1.5 py-0.5 rounded';
              countryBadge.textContent = item.country;
              left.append(countryBadge);
            }

            const right = document.createElement('div');
            right.className = 'flex items-center gap-2 shrink-0';

            const shareBadge = document.createElement('span');
            shareBadge.className = 'text-[11px] font-mono text-slate-400';
            shareBadge.textContent = `${share}%`;

            const countBadge = document.createElement('span');
            countBadge.className = 'text-xs font-mono font-bold text-amber-300 tabular-nums';
            countBadge.textContent = visits.toLocaleString('en-US');

            right.append(shareBadge, countBadge);
            topRow.append(left, right);

            const track = document.createElement('div');
            track.className = 'h-2 rounded-full bg-slate-900 overflow-hidden';
            const fill = document.createElement('div');
            fill.className = 'h-full rounded-full bg-gradient-to-l from-amber-300 to-accent-500 transition-all duration-500';
            fill.style.width = `${barWidth}%`;
            track.append(fill);

            card.append(topRow, track);
            citiesContainer.append(card);
          });
        }
      }

      // Render Top Pages List
      const pagesContainer = document.getElementById('traffic-pages-list');
      const pages = Array.isArray(data.topPages) ? data.topPages : [];

      if (pagesContainer) {
        pagesContainer.replaceChildren();
        if (pages.length === 0) {
          const empty = document.createElement('div');
          empty.className = 'py-8 text-center text-xs text-slate-400';
          empty.textContent = 'لا توجد صفحات مسجلة في هذه الفترة.';
          pagesContainer.append(empty);
        } else {
          const maxPage = Math.max(...pages.map((p) => Number(p.visits || 0)), 1);
          pages.forEach((page) => {
            const visits = Number(page.visits || 0);
            const barWidth = Math.max(5, Math.round((visits / maxPage) * 100));

            const card = document.createElement('div');
            card.className = 'p-3 rounded-xl bg-slate-950/60 border border-white/5 space-y-2';

            const row = document.createElement('div');
            row.className = 'flex items-center justify-between gap-2 text-xs';

            const titleWrap = document.createElement('div');
            titleWrap.className = 'min-w-0';
            const labelEl = document.createElement('div');
            labelEl.className = 'font-bold text-white truncate';
            labelEl.textContent = formatPageLabel(page.path);
            const pathEl = document.createElement('div');
            pathEl.className = 'text-[11px] font-mono text-slate-400 truncate';
            pathEl.dir = 'ltr';
            pathEl.textContent = page.path;
            titleWrap.append(labelEl, pathEl);

            const countEl = document.createElement('span');
            countEl.className = 'text-xs font-mono font-bold text-emerald-300 shrink-0 tabular-nums';
            countEl.textContent = visits.toLocaleString('en-US');

            row.append(titleWrap, countEl);

            const track = document.createElement('div');
            track.className = 'h-1.5 rounded-full bg-slate-900 overflow-hidden';
            const fill = document.createElement('div');
            fill.className = 'h-full rounded-full bg-gradient-to-l from-emerald-300 to-teal-500 transition-all duration-500';
            fill.style.width = `${barWidth}%`;
            track.append(fill);

            card.append(row, track);
            pagesContainer.append(card);
          });
        }
      }
    }

    async function loadTrafficData(range = currentTrafficRange, showSuccessToast = false) {
      currentTrafficRange = range;
      syncRangeButtons(range);
      refreshTrafficIcon?.classList.add('animate-spin');

      try {
        const res = await fetch(`/api/traffic?range=${encodeURIComponent(range)}`, {
          headers: { 'x-admin-key': getAdminKey() },
        });
        const data = await res.json();
        if (!res.ok) {
          throw new Error(data.error || 'تعذر تحميل إحصائيات الزيارات');
        }
        trafficLoadedOnce = true;
        renderTrafficStats(data);
        if (showSuccessToast) {
          showToast('تم تحديث إحصائيات الزيارات.');
        }
      } catch (err) {
        showToast(err instanceof Error ? err.message : 'تعذر تحميل إحصائيات الزيارات.', true);
      } finally {
        refreshTrafficIcon?.classList.remove('animate-spin');
      }
    }

    rangeButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const range = btn.dataset.range || '7d';
        loadTrafficData(range);
      });
    });

    refreshTrafficBtn?.addEventListener('click', () => {
      loadTrafficData(currentTrafficRange, true);
    });

    async function verifyKey(candidateKey) {
      try {
        const res = await fetch('/api/auth', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ key: candidateKey }),
        });
        return res.ok;
      } catch {
        return false;
      }
    }

    function unlock(verifiedKey) {
      sessionStorage.setItem(SESSION_KEY, verifiedKey);
      authGate?.classList.add('hidden');
      dashboard?.classList.remove('hidden');
      authError?.classList.add('hidden');
      const initialTab = resolveInitialTab();
      switchTab(initialTab);
      if (initialTab === 'traffic' && !trafficLoadedOnce) {
        loadTrafficData(currentTrafficRange);
      }
    }

    (async () => {
      const urlParams = new URLSearchParams(window.location.search);
      const keyParam = urlParams.get('key');
      const existing = keyParam || getAdminKey();
      if (existing && (await verifyKey(existing))) {
        unlock(existing);
      }
    })();

    authForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const val = accessKeyInput?.value || '';
      if (await verifyKey(val)) {
        unlock(val);
      } else {
        authError?.classList.remove('hidden');
      }
    });

    lockBtn?.addEventListener('click', () => {
      sessionStorage.removeItem(SESSION_KEY);
      window.location.href = '/admin';
    });

    // Contact, Top Bar & Social Settings Management (backed by Cloudflare D1)
    let currentSettings = JSON.parse(JSON.stringify(initialSettings));

    const whatsappInput = document.getElementById('setting-whatsapp');
    const phoneInput = document.getElementById('setting-phone');
    const displayPhoneInput = document.getElementById('setting-display-phone');
    const hoursInput = document.getElementById('setting-hours');
    const topBarEnabledInput = document.getElementById('setting-topbar-enabled');
    const socialFacebookInput = document.getElementById('setting-social-facebook');
    const socialInstagramInput = document.getElementById('setting-social-instagram');
    const socialTiktokInput = document.getElementById('setting-social-tiktok');
    const socialYoutubeInput = document.getElementById('setting-social-youtube');
    const settingsForm = document.getElementById('settings-form');
    const settingsStatus = document.getElementById('settings-status');

    function populateSettingsForm(data) {
      if (whatsappInput) whatsappInput.value = data.whatsappNumber || '';
      if (phoneInput) phoneInput.value = data.phone || '';
      if (displayPhoneInput) displayPhoneInput.value = data.displayPhone || '';
      if (hoursInput) hoursInput.value = data.workingHours || '';
      if (topBarEnabledInput) topBarEnabledInput.checked = data.topBar?.enabled !== false;
      if (socialFacebookInput) socialFacebookInput.value = data.social?.facebook || '';
      if (socialInstagramInput) socialInstagramInput.value = data.social?.instagram || '';
      if (socialTiktokInput) socialTiktokInput.value = data.social?.tiktok || '';
      if (socialYoutubeInput) socialYoutubeInput.value = data.social?.youtube || '';
    }

    populateSettingsForm(currentSettings);

    settingsForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const payload = {
        whatsappNumber: whatsappInput.value.trim(),
        phone: phoneInput.value.trim(),
        displayPhone: displayPhoneInput.value.trim(),
        workingHours: hoursInput.value.trim(),
        topBar: {
          enabled: Boolean(topBarEnabledInput?.checked),
        },
        social: {
          facebook: (socialFacebookInput?.value || '').trim(),
          instagram: (socialInstagramInput?.value || '').trim(),
          tiktok: (socialTiktokInput?.value || '').trim(),
          youtube: (socialYoutubeInput?.value || '').trim(),
        },
      };

      try {
        const res = await fetch('/api/settings', {
          method: 'PUT',
          headers: {
            'Content-Type': 'application/json',
            'x-admin-key': getAdminKey(),
          },
          body: JSON.stringify(payload),
        });
        const data = await res.json();
        if (!res.ok) {
          throw new Error(data.error || 'فشل الحفظ في قاعدة البيانات');
        }
        currentSettings = data.settings;
        populateSettingsForm(currentSettings);
        if (settingsStatus) {
          settingsStatus.classList.remove('hidden');
          setTimeout(() => settingsStatus.classList.add('hidden'), 4000);
        }
        showToast('تم حفظ وتطبيق الإعدادات في قاعدة البيانات لجميع الزوار.');
      } catch (err) {
        showToast(err instanceof Error ? err.message : 'تعذر الحفظ في قاعدة البيانات.', true);
      }
    });

    // Media Data Management (backed by Cloudflare D1)
    let mediaData = JSON.parse(JSON.stringify(initialMedia));

    async function saveState(successMsg) {
      try {
        const res = await fetch('/api/media', {
          method: 'PUT',
          headers: {
            'Content-Type': 'application/json',
            'x-admin-key': getAdminKey(),
          },
          body: JSON.stringify({ items: mediaData.items }),
        });
        const data = await res.json();
        if (!res.ok) {
          throw new Error(data.error || 'فشل حفظ المعرض في قاعدة البيانات');
        }
        mediaData.items = data.items;
        renderList();
        if (successMsg) showToast(successMsg);
      } catch (err) {
        showToast(err instanceof Error ? err.message : 'تعذر الحفظ في قاعدة البيانات.', true);
      }
    }

    function updateStats() {
      const items = mediaData.items;
      const totalEl = document.getElementById('stat-total');
      const imgEl = document.getElementById('stat-images');
      const vidEl = document.getElementById('stat-videos');
      if (totalEl) totalEl.textContent = String(items.length);
      if (imgEl) imgEl.textContent = String(items.filter((i) => i.type === 'image').length);
      if (vidEl) vidEl.textContent = String(items.filter((i) => i.type === 'video').length);
    }

    function moveItem(index, direction) {
      const newIndex = index + direction;
      if (newIndex < 0 || newIndex >= mediaData.items.length) return;
      const temp = mediaData.items[index];
      mediaData.items[index] = mediaData.items[newIndex];
      mediaData.items[newIndex] = temp;
      saveState('تم تحديث ترتيب المعرض في قاعدة البيانات.');
    }

    function renderList() {
      updateStats();
      const container = document.getElementById('media-table-container');
      if (!container) return;
      container.replaceChildren();

      if (mediaData.items.length === 0) {
        const empty = document.createElement('div');
        empty.className = 'p-8 text-center text-slate-300 text-sm';
        empty.textContent = 'لا توجد وسائط مضافة بعد. يمكنك البدء بإضافة صورة أو فيديو من النموذج أعلاه.';
        container.append(empty);
        return;
      }

      mediaData.items.forEach((item, index) => {
        const itemRow = document.createElement('div');
        itemRow.className = 'flex flex-col sm:flex-row items-center justify-between p-4 bg-slate-950/75 border border-white/10 rounded-xl gap-4 hover:border-white/20 transition-all duration-200';

        const left = document.createElement('div');
        left.className = 'flex items-center gap-4 w-full sm:w-auto min-w-0';

        const num = document.createElement('span');
        num.className = 'w-8 h-8 rounded-lg bg-slate-800/90 text-slate-200 font-mono text-xs font-bold flex items-center justify-center shrink-0 border border-white/10';
        num.textContent = `#${index + 1}`;

        const thumbWrap = document.createElement('div');
        thumbWrap.className = 'w-16 h-12 rounded-lg overflow-hidden bg-slate-800 shrink-0 relative ring-1 ring-white/10';
        const img = document.createElement('img');
        img.src = item.thumbnail || item.src;
        img.alt = item.title || '';
        img.className = 'w-full h-full object-cover';
        thumbWrap.append(img);

        if (item.type === 'video') {
          const vidTag = document.createElement('span');
          vidTag.className = 'absolute bottom-1 right-1 bg-red-700 text-white text-[10px] px-1.5 rounded font-bold';
          vidTag.textContent = 'فيديو';
          thumbWrap.append(vidTag);
        }

        const meta = document.createElement('div');
        meta.className = 'min-w-0';
        const titleDiv = document.createElement('div');
        titleDiv.className = 'font-bold text-white text-sm truncate';
        titleDiv.textContent = item.title || '';
        const subDiv = document.createElement('div');
        subDiv.className = 'text-xs text-slate-300 flex flex-wrap items-center gap-x-2 gap-y-0.5 mt-0.5 min-w-0';
        const catSpan = document.createElement('span');
        catSpan.className = 'text-accent-300 font-semibold';
        catSpan.textContent = item.category || '';
        const sep = document.createElement('span');
        sep.textContent = '·';
        const srcSpan = document.createElement('span');
        srcSpan.className = 'truncate font-mono text-[11px] max-w-[180px] sm:max-w-[240px]';
        srcSpan.textContent = item.src || '';
        subDiv.append(catSpan, sep, srcSpan);
        meta.append(titleDiv, subDiv);

        left.append(num, thumbWrap, meta);

        const actions = document.createElement('div');
        actions.className = 'flex flex-wrap items-center gap-2 shrink-0 self-end sm:self-center';

        const replaceBtn = document.createElement('button');
        replaceBtn.type = 'button';
        replaceBtn.className = 'px-3 py-2 rounded-lg bg-accent-600/85 hover:bg-accent active:scale-[0.98] text-white transition-all duration-200 text-xs font-bold min-h-[38px]';
        replaceBtn.textContent = item.type === 'video' ? 'تغيير الغلاف' : 'تغيير الصورة';
        replaceBtn.addEventListener('click', () => triggerReplacePhoto(index));

        const upBtn = document.createElement('button');
        upBtn.type = 'button';
        upBtn.className = 'px-3 py-2 rounded-lg bg-slate-800 hover:bg-slate-700 active:scale-[0.98] text-slate-200 hover:text-white border border-white/10 transition-all duration-200 text-xs font-bold disabled:opacity-35 disabled:pointer-events-none min-h-[38px]';
        upBtn.disabled = index === 0;
        upBtn.textContent = 'تقديم';
        upBtn.addEventListener('click', () => moveItem(index, -1));

        const downBtn = document.createElement('button');
        downBtn.type = 'button';
        downBtn.className = 'px-3 py-2 rounded-lg bg-slate-800 hover:bg-slate-700 active:scale-[0.98] text-slate-200 hover:text-white border border-white/10 transition-all duration-200 text-xs font-bold disabled:opacity-35 disabled:pointer-events-none min-h-[38px]';
        downBtn.disabled = index === mediaData.items.length - 1;
        downBtn.textContent = 'تأخير';
        downBtn.addEventListener('click', () => moveItem(index, 1));

        const previewLink = document.createElement('a');
        previewLink.href = item.src;
        previewLink.target = '_blank';
        previewLink.rel = 'noopener noreferrer';
        previewLink.className = 'px-3 py-2 rounded-lg bg-slate-800 hover:bg-slate-700 active:scale-[0.98] text-slate-200 hover:text-white border border-white/10 transition-all duration-200 text-xs font-semibold min-h-[38px] inline-flex items-center';
        previewLink.textContent = 'معاينة';

        const delBtn = document.createElement('button');
        delBtn.type = 'button';
        delBtn.className = 'px-3 py-2 rounded-lg bg-rose-950/60 hover:bg-rose-800 active:scale-[0.98] text-rose-200 hover:text-white border border-rose-500/25 transition-all duration-200 text-xs font-bold min-h-[38px]';
        delBtn.textContent = 'حذف';
        delBtn.addEventListener('click', () => {
          if (confirm('هل أنت متأكد من حذف هذا العنصر من المعرض؟')) {
            mediaData.items = mediaData.items.filter((i) => i.id !== item.id);
            saveState('تم حذف العنصر وحفظ المعرض في قاعدة البيانات.');
          }
        });

        actions.append(replaceBtn, upBtn, downBtn, previewLink, delBtn);
        itemRow.append(left, actions);
        container.append(itemRow);
      });
    }

    async function compressToWebP(file) {
      const bitmap = await createImageBitmap(file);
      const maxDim = 1400;
      const scale = Math.min(1, maxDim / Math.max(bitmap.width, bitmap.height));
      const width = Math.max(1, Math.round(bitmap.width * scale));
      const height = Math.max(1, Math.round(bitmap.height * scale));

      const canvas = document.createElement('canvas');
      canvas.width = width;
      canvas.height = height;
      const ctx = canvas.getContext('2d');
      ctx.drawImage(bitmap, 0, 0, width, height);
      bitmap.close();

      let blob = await new Promise((resolve) => canvas.toBlob(resolve, 'image/webp', 0.84));
      if (!blob) {
        blob = await new Promise((resolve) => canvas.toBlob(resolve, 'image/jpeg', 0.84));
      }
      if (!blob) throw new Error('تعذر ضغط الصورة في المتصفح');
      return blob;
    }

    async function uploadImageFile(file) {
      const compressed = await compressToWebP(file);
      const ext = compressed.type === 'image/webp' ? 'webp' : 'jpg';
      const formData = new FormData();
      formData.append('file', compressed, `photo.${ext}`);

      const res = await fetch('/api/upload', {
        method: 'POST',
        headers: { 'x-admin-key': getAdminKey() },
        body: formData,
      });
      const data = await res.json();
      if (!res.ok) {
        throw new Error(data.error || 'فشل رفع الصورة');
      }
      return data.url;
    }

    // Toggle Upload vs Video URL controls
    const typeSelect = document.getElementById('item-type');
    const photoUploadWrap = document.getElementById('photo-upload-wrap');
    const videoUrlWrap = document.getElementById('video-url-wrap');
    const videoThumbWrap = document.getElementById('video-thumb-wrap');
    const itemFileInput = document.getElementById('item-file');
    const itemFileLabel = document.getElementById('item-file-label');
    const itemPreviewWrap = document.getElementById('item-preview-wrap');
    const itemPreviewImg = document.getElementById('item-preview-img');
    const itemPreviewMeta = document.getElementById('item-preview-meta');
    const itemSrcInput = document.getElementById('item-src');
    let previewObjectUrl = '';

    function syncMediaTypeFields() {
      const isVideo = typeSelect?.value === 'video';
      photoUploadWrap?.classList.toggle('hidden', isVideo);
      videoUrlWrap?.classList.toggle('hidden', !isVideo);
      videoThumbWrap?.classList.toggle('hidden', !isVideo);
      if (itemSrcInput) itemSrcInput.required = isVideo;
      if (isVideo) itemPreviewWrap?.classList.add('hidden');
    }
    typeSelect?.addEventListener('change', syncMediaTypeFields);
    syncMediaTypeFields();

    itemFileInput?.addEventListener('change', () => {
      const file = itemFileInput.files?.[0];
      if (!file) return;
      if (previewObjectUrl) URL.revokeObjectURL(previewObjectUrl);
      previewObjectUrl = URL.createObjectURL(file);
      if (itemFileLabel) itemFileLabel.textContent = file.name;
      if (itemPreviewImg) itemPreviewImg.src = previewObjectUrl;
      if (itemPreviewMeta) {
        itemPreviewMeta.textContent = `${file.name} (${Math.round(file.size / 1024)} KB قبل الضغط)`;
      }
      itemPreviewWrap?.classList.remove('hidden');
    });

    // Replace photo directly on an existing gallery item
    const replaceInput = document.getElementById('replace-photo-input');
    let replaceTargetIndex = -1;

    function triggerReplacePhoto(index) {
      replaceTargetIndex = index;
      if (replaceInput) {
        replaceInput.value = '';
        replaceInput.click();
      }
    }

    replaceInput?.addEventListener('change', async () => {
      const file = replaceInput.files?.[0];
      if (!file || replaceTargetIndex < 0 || !mediaData.items[replaceTargetIndex]) return;
      const targetIndex = replaceTargetIndex;
      replaceTargetIndex = -1;

      showToast('جاري ضغط ورفع الصورة الجديدة...');
      try {
        const uploadedUrl = await uploadImageFile(file);
        const target = mediaData.items[targetIndex];
        if (target.type === 'video') {
          target.thumbnail = uploadedUrl;
        } else {
          target.src = uploadedUrl;
          target.thumbnail = uploadedUrl;
        }
        await saveState('تم تغيير الصورة وتحديث المعرض لكل الزوار.');
      } catch (err) {
        showToast(err instanceof Error ? err.message : 'فشل تغيير الصورة.', true);
      }
    });

    const addForm = document.getElementById('add-media-form');
    const addSubmitBtn = document.getElementById('add-media-submit');
    addForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const type = typeSelect.value;
      const category = document.getElementById('item-category').value;
      const title = document.getElementById('item-title').value.trim();
      const titleEn = document.getElementById('item-title-en').value.trim();
      const desc = document.getElementById('item-desc').value.trim();

      let src = '';
      let thumb = '';

      if (addSubmitBtn) addSubmitBtn.disabled = true;
      try {
        if (type === 'image') {
          const file = itemFileInput?.files?.[0];
          if (!file) {
            showToast('يرجى اختيار صورة من جهازك أولاً.', true);
            return;
          }
          showToast('جاري ضغط ورفع الصورة...');
          src = await uploadImageFile(file);
          thumb = src;
        } else {
          src = itemSrcInput.value.trim();
          if (src.includes('watch?v=')) {
            src = src.replace('watch?v=', 'embed/');
          }
          const thumbFile = document.getElementById('item-thumb-file')?.files?.[0];
          thumb = thumbFile ? await uploadImageFile(thumbFile) : '/media/truck-loading-cairo.jpg';
        }

        mediaData.items.unshift({
          id: Date.now().toString(),
          type,
          src,
          thumbnail: thumb,
          category,
          title,
          titleEn: titleEn || title,
          alt: title,
          altEn: titleEn || title,
          desc,
          descEn: desc,
        });
        await saveState('تم رفع الصورة وإضافتها إلى المعرض بنجاح.');
        addForm.reset();
        syncMediaTypeFields();
        if (itemFileLabel) itemFileLabel.textContent = 'اختر صورة من الهاتف أو الكمبيوتر...';
        itemPreviewWrap?.classList.add('hidden');
      } catch (err) {
        showToast(err instanceof Error ? err.message : 'فشل رفع الصورة.', true);
      } finally {
        if (addSubmitBtn) addSubmitBtn.disabled = false;
      }
    });

    document.getElementById('copy-json-btn')?.addEventListener('click', () => {
      navigator.clipboard.writeText(JSON.stringify(mediaData, null, 2)).then(() => {
        showToast('تم نسخ media.json إلى الحافظة.');
      });
    });

    document.getElementById('download-json-btn')?.addEventListener('click', () => {
      const blob = new Blob([JSON.stringify(mediaData, null, 2)], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'media.json';
      a.click();
      URL.revokeObjectURL(url);
    });

    document.getElementById('reset-default-btn')?.addEventListener('click', () => {
      if (confirm('هل تريد استعادة البيانات الافتراضية وحفظها في قاعدة البيانات؟')) {
        mediaData = JSON.parse(JSON.stringify(defaultMedia));
        saveState('تمت استعادة البيانات الافتراضية في قاعدة البيانات.');
      }
    });

    renderList();
  </script>
</body>
</html>
