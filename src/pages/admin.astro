---
import '../styles/global.css';
import defaultMedia from '../data/media.json';
import defaultSettings from '../data/settings.json';
import { SOCIAL_PLATFORMS } from '../utils/settings';
import {
  Plus,
  Key,
  CheckCircle,
  Copy,
  Download,
  Eye,
  ShieldAlert,
  Phone,
  MessageCircle,
  Clock,
  Save,
  Sliders,
} from '@lucide/astro';

const devKeyDefault = 'mover-dev-2024';
---

<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title>شركة الولاء | لوحة تحكم إدارة الموقع والوسائط</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Cairo:wght@700;800&family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&family=JetBrains+Mono:wght@500;700&display=swap"
    rel="stylesheet"
  />
  <style>
    body { font-family: 'IBM Plex Sans Arabic', 'Cairo', system-ui, sans-serif; }
    h1, h2 { font-family: 'Cairo', 'IBM Plex Sans Arabic', system-ui, sans-serif; }
    code, pre { font-family: 'JetBrains Mono', monospace; }
  </style>
</head>
<body class="dark-surface bg-primary-900 text-slate-100 min-h-screen">

  <!-- Authentication Guard Gate -->
  <div id="auth-gate" class="fixed inset-0 z-50 bg-primary-dark flex items-center justify-center p-4">
    <div class="max-w-md w-full bg-primary-800 border border-white/15 rounded-2xl p-8 shadow-2xl text-center">
      <div class="w-14 h-14 bg-accent-700/20 border border-accent-400/30 text-accent-300 rounded-xl flex items-center justify-center mx-auto mb-5">
        <Key class="w-7 h-7" aria-hidden="true" />
      </div>
      <h1 class="text-2xl font-extrabold text-white mb-2">لوحة تحكم المطور</h1>
      <p class="text-sm text-slate-300 mb-6 leading-relaxed">
        إدارة أرقام التواصل والواتساب وترتيب صور وفيديوهات المعرض. أدخل مفتاح المطور للمتابعة:
      </p>

      <form id="auth-form" class="space-y-4">
        <label for="access-key-input" class="visually-hidden">مفتاح المطور</label>
        <input
          type="password"
          id="access-key-input"
          dir="ltr"
          autocomplete="current-password"
          placeholder="أدخل مفتاح المطور (الافتراضي: mover-dev-2024)"
          class="w-full bg-primary-900 border border-white/20 rounded-xl px-4 py-3 text-sm text-center text-white placeholder-slate-400 focus:border-accent-300"
          required
        />
        <button
          type="submit"
          class="w-full bg-accent hover:bg-accent-700 text-white font-bold py-3.5 rounded-xl shadow-md transition-colors min-h-[48px]"
        >
          الدخول إلى لوحة التحكم
        </button>
      </form>
      <div id="auth-error" role="alert" class="hidden text-rose-300 text-xs mt-3 font-semibold">
        مفتاح الدخول غير صحيح، يرجى المحاولة مرة أخرى.
      </div>
    </div>
  </div>

  <!-- Main Developer Dashboard -->
  <div id="dashboard" class="hidden min-h-screen flex flex-col">
    <!-- Top Bar -->
    <header class="bg-primary-dark border-b border-white/10 px-6 py-4 sticky top-0 z-40">
      <div class="max-w-7xl mx-auto flex items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <img
            src="/logo.jpg"
            alt="شركة الولاء"
            width="44"
            height="44"
            class="w-11 h-11 rounded-xl bg-white p-1 object-contain shrink-0"
          />
          <div>
            <div class="font-extrabold text-white text-lg flex items-center gap-2">
              <span>شركة الولاء</span>
              <span class="text-xs bg-primary-800 text-accent-300 border border-white/15 px-2 py-0.5 rounded font-mono font-bold">Admin</span>
            </div>
            <div class="text-xs text-slate-300">إدارة أرقام التواصل وترتيب وسائط المعرض</div>
          </div>
        </div>

        <div class="flex items-center gap-3">
          <a href="/" target="_blank" class="inline-flex items-center gap-1.5 text-xs font-bold text-slate-200 hover:text-white bg-slate-800 hover:bg-slate-700 px-3.5 py-2.5 rounded-xl transition-colors border border-slate-700 min-h-[40px]">
            <Eye class="w-4 h-4" aria-hidden="true" />
            <span>معاينة الموقع</span>
          </a>
          <button type="button" id="lock-btn" class="text-xs font-bold text-rose-200 hover:text-white bg-rose-900/50 hover:bg-rose-800 px-3.5 py-2.5 rounded-xl border border-rose-700 transition-colors min-h-[40px]">
            قفل اللوحة
          </button>
        </div>
      </div>
    </header>

    <!-- Main Container -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
      <!-- Live Feedback Region -->
      <div id="admin-toast" role="status" aria-live="polite" class="hidden rounded-xl bg-emerald-900/90 border border-emerald-600 text-emerald-100 px-4 py-3 text-sm font-semibold flex items-center gap-2">
        <CheckCircle class="w-4 h-4 text-emerald-300 shrink-0" aria-hidden="true" />
        <span id="admin-toast-text"></span>
      </div>

      <!-- Section 1: Contact Settings -->
      <section class="bg-slate-950 border border-slate-800 rounded-2xl p-6 sm:p-8">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-6 mb-6 border-b border-slate-800 gap-4">
          <div>
            <h2 class="text-lg font-extrabold text-white flex items-center gap-2.5">
              <Sliders class="w-5 h-5 text-accent-300" aria-hidden="true" />
              <span>إدارة أرقام التواصل وحسابات السوشيال</span>
            </h2>
            <p class="text-xs text-slate-300 mt-1">تعديل أرقام الهاتف والواتساب في الشريط العلوي، والتحكم في ظهور الشريط العلوي وروابط حسابات التواصل الاجتماعي</p>
          </div>
          <div class="flex items-center gap-2">
            <button type="button" id="copy-settings-json" class="inline-flex items-center gap-1.5 bg-slate-800 hover:bg-slate-700 text-white text-xs font-bold px-3.5 py-2.5 rounded-xl transition-colors border border-slate-700 min-h-[40px]">
              <Copy class="w-3.5 h-3.5 text-emerald-300" aria-hidden="true" />
              <span>نسخ settings.json</span>
            </button>
            <button type="button" id="download-settings-json" class="inline-flex items-center gap-1.5 bg-whatsapp hover:bg-whatsapp-hover text-white text-xs font-bold px-3.5 py-2.5 rounded-xl transition-colors min-h-[40px]">
              <Download class="w-3.5 h-3.5" aria-hidden="true" />
              <span>تحميل settings.json</span>
            </button>
          </div>
        </div>

        <form id="settings-form" class="space-y-4">
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            <div>
              <label for="setting-whatsapp" class="text-xs font-bold text-slate-200 mb-1.5 flex items-center gap-1.5">
                <MessageCircle class="w-4 h-4 text-emerald-300" aria-hidden="true" />
                <span>رقم الواتساب (wa.me) *</span>
              </label>
              <input
                type="text"
                id="setting-whatsapp"
                dir="ltr"
                placeholder="201000000000"
                class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3.5 py-3 text-sm font-mono text-white placeholder-slate-400 focus:border-accent-300"
                required
              />
              <span class="text-[11px] text-slate-400 mt-1 block">بدون علامة + أو مسافات</span>
            </div>

            <div>
              <label for="setting-phone" class="text-xs font-bold text-slate-200 mb-1.5 flex items-center gap-1.5">
                <Phone class="w-4 h-4 text-accent-300" aria-hidden="true" />
                <span>رقم الاتصال المباشر (tel:) *</span>
              </label>
              <input
                type="text"
                id="setting-phone"
                dir="ltr"
                placeholder="201000000000"
                class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3.5 py-3 text-sm font-mono text-white placeholder-slate-400 focus:border-accent-300"
                required
              />
              <span class="text-[11px] text-slate-400 mt-1 block">الرقم الفعلي للاتصال</span>
            </div>

            <div>
              <label for="setting-display-phone" class="text-xs font-bold text-slate-200 mb-1.5 flex items-center gap-1.5">
                <Phone class="w-4 h-4 text-sky-300" aria-hidden="true" />
                <span>الرقم الظاهر للعميل *</span>
              </label>
              <input
                type="text"
                id="setting-display-phone"
                dir="ltr"
                placeholder="+20 100 000 0000"
                class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3.5 py-3 text-sm font-mono text-white placeholder-slate-400 focus:border-accent-300"
                required
              />
              <span class="text-[11px] text-slate-400 mt-1 block">النص المنسق على الأزرار</span>
            </div>

            <div>
              <label for="setting-hours" class="text-xs font-bold text-slate-200 mb-1.5 flex items-center gap-1.5">
                <Clock class="w-4 h-4 text-amber-300" aria-hidden="true" />
                <span>ساعات العمل *</span>
              </label>
              <input
                type="text"
                id="setting-hours"
                placeholder="خدمة عملاء 24 ساعة / 7 أيام"
                class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3.5 py-3 text-sm text-white placeholder-slate-400 focus:border-accent-300"
                required
              />
              <span class="text-[11px] text-slate-400 mt-1 block">تظهر في الشريط العلوي والفوتر</span>
            </div>
          </div>

          <fieldset class="border border-slate-800 bg-slate-900/50 rounded-xl p-4 sm:p-5 space-y-4">
            <legend class="px-2 text-xs font-extrabold text-accent-300">حسابات التواصل الاجتماعي والشريط العلوي</legend>
            <div class="flex flex-wrap items-center justify-between gap-4 pb-2 border-b border-slate-800">
              <label for="setting-topbar-enabled" class="inline-flex items-center gap-2.5 text-xs font-bold text-slate-200 cursor-pointer min-h-[36px]">
                <input
                  type="checkbox"
                  id="setting-topbar-enabled"
                  class="w-4 h-4 rounded border-slate-600 bg-slate-900 text-accent focus:ring-accent-300"
                />
                <span>إظهار الشريط العلوي (أرقام التواصل وأيقونات السوشيال)</span>
              </label>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
              {SOCIAL_PLATFORMS.map((platform) => (
                <div>
                  <label for={`setting-social-${platform.key}`} class="text-xs font-bold text-slate-200 mb-1.5 block">
                    {platform.label}
                  </label>
                  <input
                    type="url"
                    id={`setting-social-${platform.key}`}
                    dir="ltr"
                    placeholder={`https://www.${platform.key}.com/...`}
                    class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3.5 py-3 text-sm font-mono text-white placeholder-slate-400 focus:border-accent-300"
                  />
                </div>
              ))}
            </div>
            <p class="text-[11px] text-slate-400">اترك الحقل فارغاً لإخفاء أيقونة الحساب من الموقع، أو أدخل رابط https كامل لإظهارها.</p>
          </fieldset>

          <div class="flex flex-wrap items-center justify-between gap-4 pt-2">
            <div id="settings-status" role="status" class="text-xs font-bold text-emerald-300 hidden flex items-center gap-1.5">
              <CheckCircle class="w-4 h-4" aria-hidden="true" />
              <span>تم حفظ وتحديث الإعدادات بنجاح.</span>
            </div>
            <button
              type="submit"
              class="inline-flex items-center gap-2 bg-accent-400 hover:bg-accent-300 text-primary-900 font-extrabold px-6 py-3 rounded-xl shadow-md transition-colors text-sm ms-auto min-h-[44px]"
            >
              <Save class="w-4 h-4" aria-hidden="true" />
              <span>حفظ وتطبيق الإعدادات</span>
            </button>
          </div>
        </form>
      </section>

      <!-- Media Guide & Export -->
      <div class="bg-slate-800 border border-slate-700 rounded-2xl p-5 flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div class="flex items-start gap-3">
          <div class="w-9 h-9 rounded-xl bg-sky-900/50 text-sky-300 flex items-center justify-center shrink-0 mt-0.5">
            <ShieldAlert class="w-5 h-5" aria-hidden="true" />
          </div>
          <div>
            <h2 class="text-sm font-bold text-white">إدارة وسائط المعرض</h2>
            <p class="text-xs text-slate-300 mt-1 leading-relaxed">
              استخدم أزرار التقديم والتأخير لتغيير ترتيب العرض، أو احذف وأضف وسائط جديدة مع المعاينة الفورية.
            </p>
          </div>
        </div>
        <div class="flex items-center gap-2 shrink-0">
          <button type="button" id="copy-json-btn" class="inline-flex items-center gap-1.5 bg-slate-700 hover:bg-slate-600 text-white text-xs font-bold px-3.5 py-2.5 rounded-xl transition-colors min-h-[40px]">
            <Copy class="w-4 h-4 text-emerald-300" aria-hidden="true" />
            <span>نسخ media.json</span>
          </button>
          <button type="button" id="download-json-btn" class="inline-flex items-center gap-1.5 bg-whatsapp hover:bg-whatsapp-hover text-white text-xs font-bold px-3.5 py-2.5 rounded-xl transition-colors min-h-[40px]">
            <Download class="w-4 h-4" aria-hidden="true" />
            <span>تحميل media.json</span>
          </button>
        </div>
      </div>

      <!-- Live Statistics -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
        <div class="bg-slate-950 border border-slate-800 rounded-2xl p-5">
          <div class="text-xs font-bold text-slate-300">إجمالي العناصر</div>
          <div id="stat-total" class="text-3xl font-extrabold text-white mt-1 tabular-nums">0</div>
        </div>
        <div class="bg-slate-950 border border-slate-800 rounded-2xl p-5">
          <div class="text-xs font-bold text-slate-300">الصور الفوتوغرافية</div>
          <div id="stat-images" class="text-3xl font-extrabold text-sky-300 mt-1 tabular-nums">0</div>
        </div>
        <div class="bg-slate-950 border border-slate-800 rounded-2xl p-5">
          <div class="text-xs font-bold text-slate-300">مقاطع الفيديو</div>
          <div id="stat-videos" class="text-3xl font-extrabold text-rose-300 mt-1 tabular-nums">0</div>
        </div>
        <div class="bg-slate-950 border border-slate-800 rounded-2xl p-5">
          <div class="text-xs font-bold text-slate-300">حالة الحفظ</div>
          <div class="text-sm font-bold text-emerald-300 mt-2 flex items-center gap-1.5">
            <CheckCircle class="w-4 h-4" aria-hidden="true" />
            <span>محفوظة محلياً</span>
          </div>
        </div>
      </div>

      <!-- Add New Media Form -->
      <section class="bg-slate-950 border border-slate-800 rounded-2xl p-6 sm:p-8">
        <div class="mb-6 pb-4 border-b border-slate-800">
          <h2 class="text-lg font-extrabold text-white flex items-center gap-2">
            <Plus class="w-5 h-5 text-accent-300" aria-hidden="true" />
            <span>إضافة صورة أو فيديو جديد للمعرض</span>
          </h2>
          <p class="text-xs text-slate-300 mt-1">أدخل بيانات الوسيط لإدراجه في المعرض</p>
        </div>

        <form id="add-media-form" class="space-y-5">
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div>
              <label for="item-type" class="block text-xs font-bold text-slate-200 mb-1.5">نوع الوسيط *</label>
              <select id="item-type" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3.5 py-3 text-sm font-medium text-white focus:border-accent-300">
                <option value="image">صورة (Image)</option>
                <option value="video">فيديو (YouTube Video)</option>
              </select>
            </div>

            <div>
              <label for="item-category" class="block text-xs font-bold text-slate-200 mb-1.5">التصنيف *</label>
              <select id="item-category" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3.5 py-3 text-sm font-medium text-white focus:border-accent-300">
                <option value="moving">سيارات وأوناش النقل</option>
                <option value="packing">التغليف المبطن والحراري</option>
                <option value="team">فريق العمل والفك والتركيب</option>
                <option value="storage">مستودعات الأمان</option>
              </select>
            </div>

            <div>
              <label for="item-src" class="block text-xs font-bold text-slate-200 mb-1.5">رابط الصورة أو الفيديو *</label>
              <input
                type="text"
                id="item-src"
                dir="ltr"
                placeholder="https://... or /media/photo.jpg"
                class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3.5 py-3 text-sm font-medium text-white placeholder-slate-400 focus:border-accent-300"
                required
              />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="item-title" class="block text-xs font-bold text-slate-200 mb-1.5">العنوان بالعربية *</label>
              <input
                type="text"
                id="item-title"
                placeholder="مثال: نقل عفش فيلا بالتجمع الخامس"
                class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3.5 py-3 text-sm font-medium text-white placeholder-slate-400 focus:border-accent-300"
                required
              />
            </div>

            <div>
              <label for="item-title-en" class="block text-xs font-bold text-slate-200 mb-1.5">العنوان بالإنجليزية (اختياري)</label>
              <input
                type="text"
                id="item-title-en"
                dir="ltr"
                placeholder="e.g. Villa Relocation in New Cairo"
                class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3.5 py-3 text-sm font-medium text-white placeholder-slate-400 focus:border-accent-300"
              />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="item-desc" class="block text-xs font-bold text-slate-200 mb-1.5">الوصف بالعربية *</label>
              <input
                type="text"
                id="item-desc"
                placeholder="تفاصيل مختصرة عن العملية والمعدات المستخدمة"
                class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3.5 py-3 text-sm font-medium text-white placeholder-slate-400 focus:border-accent-300"
                required
              />
            </div>

            <div>
              <label for="item-thumb" class="block text-xs font-bold text-slate-200 mb-1.5">رابط صورة مصغرة (اختياري)</label>
              <input
                type="text"
                id="item-thumb"
                dir="ltr"
                placeholder="https://... poster image URL"
                class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3.5 py-3 text-sm font-medium text-white placeholder-slate-400 focus:border-accent-300"
              />
            </div>
          </div>

          <div class="flex justify-end pt-2">
            <button
              type="submit"
              class="inline-flex items-center gap-2 bg-accent hover:bg-accent-700 text-white font-bold px-7 py-3.5 rounded-xl shadow-md transition-colors min-h-[48px]"
            >
              <Plus class="w-5 h-5" aria-hidden="true" />
              <span>إضافة إلى المعرض</span>
            </button>
          </div>
        </form>
      </section>

      <!-- Current Media Catalog -->
      <section class="bg-slate-950 border border-slate-800 rounded-2xl p-6 sm:p-8">
        <div class="flex flex-wrap items-center justify-between gap-4 mb-6 pb-4 border-b border-slate-800">
          <div>
            <h2 class="text-lg font-extrabold text-white">ترتيب وسائط المعرض الحالية</h2>
            <p class="text-xs text-slate-300 mt-1">استخدم أزرار التقديم والتأخير لتغيير الترتيب، أو احذف أي عنصر</p>
          </div>
          <button type="button" id="reset-default-btn" class="text-xs font-bold text-slate-200 hover:text-white bg-slate-800 hover:bg-slate-700 px-3.5 py-2 rounded-xl border border-slate-700 transition-colors min-h-[38px]">
            استعادة القائمة الأصلية
          </button>
        </div>

        <div id="media-table-container" class="space-y-3"></div>
      </section>
    </main>
  </div>

  <script define:vars={{ defaultMedia, defaultSettings, devKeyDefault }}>
    const authGate = document.getElementById('auth-gate');
    const dashboard = document.getElementById('dashboard');
    const authForm = document.getElementById('auth-form');
    const accessKeyInput = document.getElementById('access-key-input');
    const authError = document.getElementById('auth-error');
    const lockBtn = document.getElementById('lock-btn');
    const toast = document.getElementById('admin-toast');
    const toastText = document.getElementById('admin-toast-text');

    function showToast(msg) {
      if (!toast || !toastText) return;
      toastText.textContent = msg;
      toast.classList.remove('hidden');
      setTimeout(() => toast.classList.add('hidden'), 3500);
    }

    const urlParams = new URLSearchParams(window.location.search);
    const keyParam = urlParams.get('key');

    function unlock() {
      authGate?.classList.add('hidden');
      dashboard?.classList.remove('hidden');
      sessionStorage.setItem('mover_admin_authed', 'true');
    }

    if (keyParam === devKeyDefault || sessionStorage.getItem('mover_admin_authed') === 'true') {
      unlock();
    }

    authForm?.addEventListener('submit', (e) => {
      e.preventDefault();
      if (accessKeyInput && accessKeyInput.value === devKeyDefault) {
        unlock();
      } else {
        authError?.classList.remove('hidden');
      }
    });

    lockBtn?.addEventListener('click', () => {
      sessionStorage.removeItem('mover_admin_authed');
      window.location.href = '/admin';
    });

    // Contact, Top Bar & Social Settings Management
    let storedSettings = null;
    try {
      storedSettings = JSON.parse(localStorage.getItem('mover_settings') || 'null');
    } catch {}
    let currentSettings = {
      ...defaultSettings,
      ...(storedSettings || {}),
      topBar: {
        ...(defaultSettings.topBar || {}),
        ...(storedSettings?.topBar || {}),
      },
      social: {
        ...(defaultSettings.social || {}),
        ...(storedSettings?.social || {}),
      },
    };

    const whatsappInput = document.getElementById('setting-whatsapp');
    const phoneInput = document.getElementById('setting-phone');
    const displayPhoneInput = document.getElementById('setting-display-phone');
    const hoursInput = document.getElementById('setting-hours');
    const topBarEnabledInput = document.getElementById('setting-topbar-enabled');
    const socialFacebookInput = document.getElementById('setting-social-facebook');
    const socialInstagramInput = document.getElementById('setting-social-instagram');
    const socialTiktokInput = document.getElementById('setting-social-tiktok');
    const socialYoutubeInput = document.getElementById('setting-social-youtube');
    const settingsForm = document.getElementById('settings-form');
    const settingsStatus = document.getElementById('settings-status');

    if (whatsappInput) whatsappInput.value = currentSettings.whatsappNumber || '';
    if (phoneInput) phoneInput.value = currentSettings.phone || '';
    if (displayPhoneInput) displayPhoneInput.value = currentSettings.displayPhone || '';
    if (hoursInput) hoursInput.value = currentSettings.workingHours || '';
    if (topBarEnabledInput) topBarEnabledInput.checked = currentSettings.topBar?.enabled !== false;
    if (socialFacebookInput) socialFacebookInput.value = currentSettings.social?.facebook || '';
    if (socialInstagramInput) socialInstagramInput.value = currentSettings.social?.instagram || '';
    if (socialTiktokInput) socialTiktokInput.value = currentSettings.social?.tiktok || '';
    if (socialYoutubeInput) socialYoutubeInput.value = currentSettings.social?.youtube || '';

    settingsForm?.addEventListener('submit', (e) => {
      e.preventDefault();
      currentSettings = {
        whatsappNumber: whatsappInput.value.trim(),
        phone: phoneInput.value.trim(),
        displayPhone: displayPhoneInput.value.trim(),
        workingHours: hoursInput.value.trim(),
        topBar: {
          enabled: Boolean(topBarEnabledInput?.checked),
        },
        social: {
          facebook: (socialFacebookInput?.value || '').trim(),
          instagram: (socialInstagramInput?.value || '').trim(),
          tiktok: (socialTiktokInput?.value || '').trim(),
          youtube: (socialYoutubeInput?.value || '').trim(),
        },
      };
      localStorage.setItem('mover_settings', JSON.stringify(currentSettings));
      if (settingsStatus) {
        settingsStatus.classList.remove('hidden');
        setTimeout(() => settingsStatus.classList.add('hidden'), 4000);
      }
      showToast('تم حفظ وتحديث الإعدادات بنجاح.');
    });

    document.getElementById('copy-settings-json')?.addEventListener('click', () => {
      navigator.clipboard.writeText(JSON.stringify(currentSettings, null, 2)).then(() => {
        showToast('تم نسخ settings.json إلى الحافظة.');
      });
    });

    document.getElementById('download-settings-json')?.addEventListener('click', () => {
      const blob = new Blob([JSON.stringify(currentSettings, null, 2)], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'settings.json';
      a.click();
      URL.revokeObjectURL(url);
    });

    // Media Data Management
    let mediaData = null;
    try {
      mediaData = JSON.parse(localStorage.getItem('mover_custom_media') || 'null');
    } catch {}
    if (!mediaData || !Array.isArray(mediaData.items)) {
      mediaData = JSON.parse(JSON.stringify(defaultMedia));
    }

    function saveState() {
      localStorage.setItem('mover_custom_media', JSON.stringify(mediaData));
      renderList();
    }

    function updateStats() {
      const items = mediaData.items;
      const totalEl = document.getElementById('stat-total');
      const imgEl = document.getElementById('stat-images');
      const vidEl = document.getElementById('stat-videos');
      if (totalEl) totalEl.textContent = String(items.length);
      if (imgEl) imgEl.textContent = String(items.filter((i) => i.type === 'image').length);
      if (vidEl) vidEl.textContent = String(items.filter((i) => i.type === 'video').length);
    }

    function moveItem(index, direction) {
      const newIndex = index + direction;
      if (newIndex < 0 || newIndex >= mediaData.items.length) return;
      const temp = mediaData.items[index];
      mediaData.items[index] = mediaData.items[newIndex];
      mediaData.items[newIndex] = temp;
      saveState();
    }

    function renderList() {
      updateStats();
      const container = document.getElementById('media-table-container');
      if (!container) return;
      container.replaceChildren();

      if (mediaData.items.length === 0) {
        const empty = document.createElement('div');
        empty.className = 'p-8 text-center text-slate-300 text-sm';
        empty.textContent = 'لا توجد وسائط مضافة بعد. يمكنك البدء بإضافة صورة أو فيديو من النموذج أعلاه.';
        container.append(empty);
        return;
      }

      mediaData.items.forEach((item, index) => {
        const itemRow = document.createElement('div');
        itemRow.className = 'flex flex-col sm:flex-row items-center justify-between p-4 bg-slate-900 border border-slate-800 rounded-xl gap-4 hover:border-slate-700 transition-colors';

        const left = document.createElement('div');
        left.className = 'flex items-center gap-4 w-full sm:w-auto min-w-0';

        const num = document.createElement('span');
        num.className = 'w-8 h-8 rounded-lg bg-slate-800 text-slate-200 font-mono text-xs font-bold flex items-center justify-center shrink-0 border border-slate-700';
        num.textContent = `#${index + 1}`;

        const thumbWrap = document.createElement('div');
        thumbWrap.className = 'w-16 h-12 rounded-lg overflow-hidden bg-slate-800 shrink-0 relative';
        const img = document.createElement('img');
        img.src = item.thumbnail || item.src;
        img.alt = item.title || '';
        img.className = 'w-full h-full object-cover';
        thumbWrap.append(img);

        if (item.type === 'video') {
          const vidTag = document.createElement('span');
          vidTag.className = 'absolute bottom-1 right-1 bg-red-700 text-white text-[10px] px-1.5 rounded font-bold';
          vidTag.textContent = 'فيديو';
          thumbWrap.append(vidTag);
        }

        const meta = document.createElement('div');
        meta.className = 'min-w-0';
        const titleDiv = document.createElement('div');
        titleDiv.className = 'font-bold text-white text-sm truncate';
        titleDiv.textContent = item.title || '';
        const subDiv = document.createElement('div');
        subDiv.className = 'text-xs text-slate-300 flex items-center gap-2 mt-0.5';
        const catSpan = document.createElement('span');
        catSpan.className = 'text-accent-300 font-semibold';
        catSpan.textContent = item.category || '';
        const sep = document.createElement('span');
        sep.textContent = '·';
        const srcSpan = document.createElement('span');
        srcSpan.className = 'truncate font-mono text-[11px] max-w-[240px]';
        srcSpan.textContent = item.src || '';
        subDiv.append(catSpan, sep, srcSpan);
        meta.append(titleDiv, subDiv);

        left.append(num, thumbWrap, meta);

        const actions = document.createElement('div');
        actions.className = 'flex items-center gap-2 shrink-0 self-end sm:self-center';

        const upBtn = document.createElement('button');
        upBtn.type = 'button';
        upBtn.className = 'px-3 py-2 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 hover:text-white transition-colors text-xs font-bold disabled:opacity-35 disabled:pointer-events-none min-h-[38px]';
        upBtn.disabled = index === 0;
        upBtn.textContent = 'تقديم';
        upBtn.addEventListener('click', () => moveItem(index, -1));

        const downBtn = document.createElement('button');
        downBtn.type = 'button';
        downBtn.className = 'px-3 py-2 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 hover:text-white transition-colors text-xs font-bold disabled:opacity-35 disabled:pointer-events-none min-h-[38px]';
        downBtn.disabled = index === mediaData.items.length - 1;
        downBtn.textContent = 'تأخير';
        downBtn.addEventListener('click', () => moveItem(index, 1));

        const previewLink = document.createElement('a');
        previewLink.href = item.src;
        previewLink.target = '_blank';
        previewLink.rel = 'noopener noreferrer';
        previewLink.className = 'px-3 py-2 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 hover:text-white transition-colors text-xs font-semibold min-h-[38px] inline-flex items-center';
        previewLink.textContent = 'معاينة';

        const delBtn = document.createElement('button');
        delBtn.type = 'button';
        delBtn.className = 'px-3 py-2 rounded-lg bg-rose-900/50 hover:bg-rose-800 text-rose-200 hover:text-white transition-colors text-xs font-bold min-h-[38px]';
        delBtn.textContent = 'حذف';
        delBtn.addEventListener('click', () => {
          if (confirm('هل أنت متأكد من حذف هذا العنصر من المعرض؟')) {
            mediaData.items = mediaData.items.filter((i) => i.id !== item.id);
            saveState();
            showToast('تم حذف العنصر وتحديث القائمة.');
          }
        });

        actions.append(upBtn, downBtn, previewLink, delBtn);
        itemRow.append(left, actions);
        container.append(itemRow);
      });
    }

    const addForm = document.getElementById('add-media-form');
    addForm?.addEventListener('submit', (e) => {
      e.preventDefault();
      const type = document.getElementById('item-type').value;
      const category = document.getElementById('item-category').value;
      let src = document.getElementById('item-src').value.trim();
      const title = document.getElementById('item-title').value.trim();
      const titleEn = document.getElementById('item-title-en').value.trim();
      const desc = document.getElementById('item-desc').value.trim();
      let thumb = document.getElementById('item-thumb').value.trim();

      if (type === 'video' && src.includes('watch?v=')) {
        src = src.replace('watch?v=', 'embed/');
      }
      if (!thumb) {
        thumb = type === 'video'
          ? '/media/truck-loading-cairo.jpg'
          : src;
      }

      mediaData.items.unshift({
        id: Date.now().toString(),
        type,
        src,
        thumbnail: thumb,
        category,
        title,
        titleEn: titleEn || title,
        desc,
        descEn: desc,
      });
      saveState();
      addForm.reset();
      showToast('تمت إضافة العنصر وتحديث المعرض.');
    });

    document.getElementById('copy-json-btn')?.addEventListener('click', () => {
      navigator.clipboard.writeText(JSON.stringify(mediaData, null, 2)).then(() => {
        showToast('تم نسخ media.json إلى الحافظة.');
      });
    });

    document.getElementById('download-json-btn')?.addEventListener('click', () => {
      const blob = new Blob([JSON.stringify(mediaData, null, 2)], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'media.json';
      a.click();
      URL.revokeObjectURL(url);
    });

    document.getElementById('reset-default-btn')?.addEventListener('click', () => {
      if (confirm('هل تريد استعادة البيانات الافتراضية؟')) {
        mediaData = JSON.parse(JSON.stringify(defaultMedia));
        saveState();
        showToast('تمت استعادة البيانات الافتراضية.');
      }
    });

    renderList();
  </script>
</body>
</html>
