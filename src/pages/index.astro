---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import MediaGallery from '../components/MediaGallery.astro';
import Stats from '../components/Stats.astro';
import Services from '../components/Services.astro';
import WhyUs from '../components/WhyUs.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Areas from '../components/Areas.astro';
import Testimonials from '../components/Testimonials.astro';
import FAQ from '../components/FAQ.astro';
import CTABanner from '../components/CTABanner.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import Footer from '../components/Footer.astro';
import { getMediaItems, getRuntimeEnv, getSiteSettings } from '../utils/db';

export const prerender = false;

const lang = 'ar';
const { db } = getRuntimeEnv(Astro.locals);
const [settings, mediaItems] = await Promise.all([
  getSiteSettings(db),
  getMediaItems(db),
]);

Astro.response.headers.set('Cache-Control', 'no-store');
---

<Layout
  title="نقل عفش بالقاهرة والجيزة | شركة الولاء لنقل وتغليف الأثاث — ضمان مكتوب"
  description="شركة نقل عفش في القاهرة والجيزة. فك وتركيب غرف ومطابخ، تغليف 5 طبقات، ونش رفع هيدروليكي حتى الدور 20، نقل بين المحافظات. ضمان مكتوب وسعر ثابت."
  lang={lang}
  settings={settings}
>
  <Header lang={lang} settings={settings} />
  <main id="main-content" tabindex="-1">
    <Hero lang={lang} settings={settings} />
    <MediaGallery lang={lang} items={mediaItems} />
    <Stats lang={lang} />
    <Services lang={lang} settings={settings} />
    <WhyUs lang={lang} />
    <HowItWorks lang={lang} />
    <Areas lang={lang} settings={settings} />
    <Testimonials lang={lang} />
    <FAQ lang={lang} settings={settings} />
    <CTABanner lang={lang} settings={settings} />
  </main>
  <WhatsAppButton lang={lang} settings={settings} />
  <Footer lang={lang} settings={settings} />
</Layout>
