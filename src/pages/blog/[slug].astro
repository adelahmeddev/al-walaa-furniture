---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import BlogCTA from '../../components/BlogCTA.astro';
import BlogCard from '../../components/BlogCard.astro';
import TableOfContents, { type TocItem } from '../../components/TableOfContents.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import { getBlogPostBySlug, getBlogPosts, incrementPostViews, getRuntimeEnv, getSiteSettings } from '../../utils/db';
import { buildBlogPostSchema, buildBlogFaqSchema, buildBreadcrumbSchema } from '../../utils/seo';
import { Calendar, Clock, Share2, MessageCircle, ShieldCheck, UserCheck, HelpCircle } from '@lucide/astro';

export const prerender = false;

const { slug } = Astro.params;
if (!slug) {
  return Astro.redirect('/blog');
}

const lang = 'ar';
const { db } = getRuntimeEnv(Astro.locals);

const [settings, post] = await Promise.all([
  getSiteSettings(db),
  getBlogPostBySlug(db, slug, lang),
]);

if (!post) {
  return Astro.redirect('/blog');
}

// Increment post views asynchronously without blocking page render
if (db && post.id) {
  const runtimeCtx = (Astro.locals as { runtime?: { ctx?: { waitUntil?: (p: Promise<unknown>) => void } } }).runtime?.ctx;
  const viewPromise = incrementPostViews(db, post.id);
  if (runtimeCtx && typeof runtimeCtx.waitUntil === 'function') {
    runtimeCtx.waitUntil(viewPromise);
  }
}

// Fetch 3 related posts for internal linking
const allPosts = await getBlogPosts(db, { lang, limit: 4, publishedOnly: true });
const relatedPosts = allPosts.filter((p) => p.slug !== post.slug).slice(0, 3);

// Generate Table of Contents from H2/H3 headings
const fallbackHeadingRegex = /<(h[23])(?:[^>]*)>(.*?)<\/\1>/gi;
const tocItems: TocItem[] = [];

let processedContent = post.content;
let headingIndex = 0;

processedContent = processedContent.replace(fallbackHeadingRegex, (_match, tag, text) => {
  headingIndex++;
  const plainText = text.replace(/<[^>]+>/g, '').trim();
  const id = `heading-${headingIndex}`;
  const level = tag.toLowerCase() === 'h2' ? 2 : 3;
  tocItems.push({ id, text: plainText, level });
  return `<${tag} id="${id}" class="scroll-mt-28">${text}</${tag}>`;
});

const siteOrigin = (Astro.site?.toString() || 'https://alwalaamoving.com').replace(/\/$/, '');
const pageUrl = `${siteOrigin}/blog/${post.slug}`;

const breadcrumbItems = [
  { name: 'الرئيسية', url: '/' },
  { name: 'المدونة', url: '/blog' },
  { name: post.title, url: `/blog/${post.slug}` },
];

const postSchema = buildBlogPostSchema(post, siteOrigin, pageUrl);
const faqSchema = buildBlogFaqSchema(post.faq);
const breadcrumbSchema = buildBreadcrumbSchema(breadcrumbItems, siteOrigin);

const schemas = [postSchema, breadcrumbSchema];
if (faqSchema) schemas.push(faqSchema);

const formattedDate = new Date(post.createdAt).toLocaleDateString('ar-EG', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const shareWhatsappUrl = `https://api.whatsapp.com/send?text=${encodeURIComponent(post.title + ' ' + pageUrl)}`;
const shareFbUrl = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(pageUrl)}`;

Astro.response.headers.set('Cache-Control', 'no-store');
---

<Layout
  title={`${post.title} | شركة الولاء لنقل الأثاث`}
  description={post.description}
  ogImage={post.coverImage}
  ogType="article"
  articleMeta={{
    publishedTime: post.createdAt,
    modifiedTime: post.updatedAt,
    section: post.category,
    tags: post.tags,
  }}
  lang={lang}
  settings={settings}
  customSchemas={schemas}
  alternateAr={`/blog/${post.slug}`}
  alternateEn="/en/blog"
>
  <Header lang={lang} settings={settings} />

  <main id="main-content" class="pt-28 sm:pt-32 pb-20 bg-surface-warm min-h-screen">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Breadcrumbs -->
      <Breadcrumbs items={breadcrumbItems} lang={lang} />

      <article class="bg-white rounded-3xl border border-stone-200 shadow-sm p-6 sm:p-10 lg:p-12 overflow-hidden">
        <!-- Post Header -->
        <header class="mb-8 space-y-4">
          <div class="flex flex-wrap items-center gap-2 text-xs font-bold">
            <span class="px-3 py-1 rounded-full bg-accent-100 text-accent-900 border border-accent-200">
              {post.category === 'pricing' && 'أسعار وتكاليف'}
              {post.category === 'hoist' && 'أوناش ورفع'}
              {post.category === 'packing' && 'تغليف وحماية'}
              {post.category === 'areas' && 'مناطق وتغطية'}
              {post.category === 'tips' && 'نصائح وإرشادات'}
            </span>

            <span class="inline-flex items-center gap-1 text-slate-500 font-medium">
              <Calendar class="w-3.5 h-3.5 text-accent" aria-hidden="true" />
              <time datetime={post.createdAt}>{formattedDate}</time>
            </span>

            <span class="text-stone-300" aria-hidden="true">•</span>

            <span class="inline-flex items-center gap-1 text-slate-500 font-medium">
              <Clock class="w-3.5 h-3.5 text-accent" aria-hidden="true" />
              <span>{post.readTime}</span>
            </span>
          </div>

          <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-primary-900 tracking-tight leading-snug">
            {post.title}
          </h1>

          <p class="text-slate-600 text-base sm:text-lg leading-relaxed font-medium border-s-4 border-accent ps-4 my-4 bg-stone-50 py-2.5 rounded-e-xl">
            {post.excerpt}
          </p>

          <!-- Author Credibility Badge (E-E-A-T) -->
          <div class="flex items-center gap-3 pt-2 text-xs text-slate-600 border-t border-stone-100">
            <div class="w-8 h-8 rounded-full bg-primary-900 text-white flex items-center justify-center font-bold shrink-0">
              <UserCheck class="w-4 h-4 text-accent-300" />
            </div>
            <div>
              <div class="font-bold text-slate-900">إشراف: فريق خبراء شركة الولاء لنقل الأثاث</div>
              <div class="text-[11px] text-slate-500">خبرة ميدانية متراكمة منذ 2014 في القاهرة والجيزة والمحافظات</div>
            </div>
          </div>
        </header>

        <!-- Cover Image with explicit dimensions (Prevents CLS) -->
        <div class="my-8 rounded-2xl overflow-hidden bg-slate-100 border border-stone-200 shadow-xs aspect-16/9">
          <img
            src={post.coverImage}
            alt={post.title}
            width="1200"
            height="675"
            fetchpriority="high"
            decoding="async"
            class="w-full h-full object-cover"
          />
        </div>

        <!-- Table of Contents -->
        {tocItems.length > 0 && <TableOfContents items={tocItems} lang={lang} />}

        <!-- Post Content HTML -->
        <div
          class="prose prose-slate max-w-none text-slate-800 leading-relaxed text-base sm:text-lg space-y-6 [&_h2]:text-xl [&_h2]:sm:text-2xl [&_h2]:font-extrabold [&_h2]:text-primary-900 [&_h2]:mt-10 [&_h2]:mb-4 [&_h2]:border-b [&_h2]:border-stone-200 [&_h2]:pb-2 [&_h3]:text-lg [&_h3]:sm:text-xl [&_h3]:font-bold [&_h3]:text-slate-900 [&_h3]:mt-6 [&_h3]:mb-3 [&_ul]:list-disc [&_ul]:pe-6 [&_ol]:list-decimal [&_ol]:pe-6 [&_li]:my-2 [&_p]:my-4 [&_strong]:text-slate-900 [&_table]:my-6 [&_table]:w-full"
          set:html={processedContent}
        />

        <!-- Contextual Quote CTA Banner -->
        <BlogCTA lang={lang} settings={settings} contextTitle={post.title} />

        <!-- FAQ Section with Schema Accordions -->
        {post.faq && post.faq.length > 0 && (
          <section class="my-12 pt-8 border-t border-stone-200">
            <div class="flex items-center gap-2 mb-6">
              <HelpCircle class="w-5 h-5 text-accent" aria-hidden="true" />
              <h2 class="text-xl sm:text-2xl font-extrabold text-primary-900 tracking-tight">
                أسئلة شائعة حول هذا الموضوع
              </h2>
            </div>

            <div class="space-y-3.5">
              {post.faq.map((item, idx) => (
                <details
                  class="group bg-stone-50 rounded-2xl border border-stone-200/90 overflow-hidden transition-all duration-200 open:bg-white open:shadow-xs open:border-accent-300"
                  open={idx === 0}
                >
                  <summary class="flex items-center justify-between gap-4 p-5 cursor-pointer font-bold text-slate-900 select-none hover:text-accent transition-colors">
                    <span class="text-sm sm:text-base">{item.question}</span>
                    <span class="w-6 h-6 rounded-full bg-stone-200 group-open:bg-accent group-open:text-white flex items-center justify-center text-xs font-bold shrink-0 transition-transform group-open:rotate-180">
                      ↓
                    </span>
                  </summary>
                  <div class="px-5 pb-5 pt-1 text-sm sm:text-base text-slate-600 leading-relaxed border-t border-stone-100 group-open:block">
                    {item.answer}
                  </div>
                </details>
              ))}
            </div>
          </section>
        )}

        <!-- Author Guarantee Box -->
        <div class="my-10 p-6 rounded-2xl bg-amber-50/60 border border-amber-200/80 flex items-start gap-4">
          <ShieldCheck class="w-8 h-8 text-amber-700 shrink-0 mt-0.5" aria-hidden="true" />
          <div class="space-y-1.5 text-xs sm:text-sm text-amber-950">
            <div class="font-extrabold text-base text-amber-900">
              ضمان شركة الولاء المكتوب لسلامة المنقولات
            </div>
            <p class="leading-relaxed">
              جميع النصائح والخدمات الواردة في هذا الدليل مطبقة ميدانياً تحت إشراف مهندسين وفنيين مرخصين. نلتزم بعقد رسمي مكتوب يضمن تعويضاً كاملاً في حال حدوث أي خدش أو كسر غير متوقع.
            </p>
          </div>
        </div>

        <!-- Social Share Bar -->
        <footer class="pt-6 border-t border-stone-200 flex flex-wrap items-center justify-between gap-4">
          <div class="flex items-center gap-2 text-xs font-bold text-slate-700">
            <Share2 class="w-4 h-4 text-accent" aria-hidden="true" />
            <span>شارك هذا الدليل مع أصدقائك:</span>
          </div>

          <div class="flex items-center gap-2">
            <a
              href={shareWhatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-whatsapp hover:bg-whatsapp-hover text-white text-xs font-bold shadow-xs transition-colors"
            >
              <MessageCircle class="w-3.5 h-3.5" />
              <span>واتساب</span>
            </a>

            <a
              href={shareFbUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold shadow-xs transition-colors"
            >
              <span>فيسبوك</span>
            </a>
          </div>
        </footer>
      </article>

      <!-- Related Posts Section (Internal Links Juice) -->
      {relatedPosts.length > 0 && (
        <section class="mt-16 pt-12 border-t border-stone-200">
          <h2 class="text-xl sm:text-2xl font-extrabold text-primary-900 tracking-tight mb-8">
            أدلة ومقالات قد تهمك أيضاً
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {relatedPosts.map((relPost) => (
              <BlogCard post={relPost} lang={lang} />
            ))}
          </div>
        </section>
      )}
    </div>
  </main>

  <WhatsAppButton lang={lang} settings={settings} />
  <Footer lang={lang} settings={settings} />
</Layout>
